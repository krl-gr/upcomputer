---
/**
 * Homepage hero: a static replica of the Up.computer window whose chats tell
 * the product story. The window stays pinned while the page scrolls, and each
 * scroll step opens the next chat. Wide screens show the chats in the sidebar;
 * small screens hide the sidebar and show them as the app's top thread tabs.
 */

interface StoryChat {
  id: string;
  title: string;
  meta: string;
  status?: "Working";
  project: { name: string; mark: string; tone: string } | null;
  model: string;
}

const chats: StoryChat[] = [
  {
    id: "how",
    title: "How does Up.computer work?",
    meta: "now",
    project: null,
    model: "Claude · Claude Fable 5.1",
  },
  {
    id: "overnight",
    title: "How should I use tasks?",
    meta: "8h",
    project: { name: "Research", mark: "R", tone: "purple" },
    model: "Codex · GPT-6 Astra",
  },
  {
    id: "history",
    title: "Where do my chats live?",
    meta: "1d",
    project: null,
    model: "Grok Build · Grok 4.6",
  },
  {
    id: "studio",
    title: "Ableton template for mixing",
    meta: "2d",
    project: { name: "Studio", mark: "S", tone: "orange" },
    model: "Pi · OpenAI · GPT-5.5",
  },
  {
    id: "different",
    title: "How is this different from Cowork?",
    meta: "3d",
    project: null,
    model: "Claude · Claude Fable 5.1",
  },
  {
    id: "cost",
    title: "What does it cost?",
    meta: "3d",
    project: null,
    model: "Codex · GPT-6 Astra",
  },
];

const projects = [
  { name: "Studio", mark: "S", tone: "orange" },
  { name: "Research", mark: "R", tone: "purple" },
  { name: "Website", mark: "W", tone: "mint" },
];

const icons = {
  search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/>',
  tasks:
    '<rect x="3" y="5" width="6" height="6" rx="1"/><path d="m3 17 2 2 4-4"/><path d="M13 6h8"/><path d="M13 12h8"/><path d="M13 18h8"/>',
  agents:
    '<path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/>',
  automations:
    '<path d="M21 7.5V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h3.5"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h5"/><path d="M17.5 17.5 16 16.3V14"/><circle cx="16" cy="16" r="6"/>',
  settings:
    '<path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"/><circle cx="12" cy="12" r="3"/>',
  chevron: '<path d="m6 9 6 6 6-6"/>',
  compose:
    '<path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.4 2.6a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4Z"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  alert: '<circle cx="12" cy="12" r="9"/><path d="M12 8v4"/><path d="M12 16h.01"/>',
  cursor: '<path d="m4 4 7 17 2.5-7.5L21 11Z"/>',
  database:
    '<ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5"/><path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"/>',
  queue: '<path d="M3 6h18"/><path d="M3 12h12"/><path d="M3 18h6"/>',
  close: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
  // lucide MessageSquareDashed, the app's "No project" chat icon.
  noProject:
    '<path d="M14 3h2"/><path d="M16 19h-2"/><path d="M2 12v-2"/><path d="M2 16v5.286a.71.71 0 0 0 1.212.502l1.149-1.149"/><path d="M20 19a2 2 0 0 0 2-2v-1"/><path d="M22 10v2"/><path d="M22 6V5a2 2 0 0 0-2-2"/><path d="M4 3a2 2 0 0 0-2 2v1"/><path d="M8 19h2"/><path d="M8 3h2"/>',
};

// The app's filled panel icon, used for the sidebar and context toggles.
const panelIconPath =
  "M12.154 2.004C13.739 2.084 15 3.395 15 5v6c0 1.605-1.261 2.916-2.846 2.996L12 14H4c-1.657 0-3-1.343-3-3V5c0-1.657 1.343-3 3-3h8l.154.004ZM4 3.25c-.967 0-1.75.784-1.75 1.75v6c0 .967.783 1.75 1.75 1.75h8c.967 0 1.75-.783 1.75-1.75V5c0-.966-.783-1.75-1.75-1.75H4Zm8 1.125c.345 0 .625.28.625.625v6a.625.625 0 1 1-1.25 0V5c0-.345.28-.625.625-.625Z";

const svg = (name: keyof typeof icons) =>
  `<svg viewBox="0 0 24 24" aria-hidden="true">${icons[name]}</svg>`;

const first = chats[0]!;
---

<section class="story" data-story style={`--steps: ${chats.length}`}>
  <div class="story-stage">
    <picture class="story-bg" aria-hidden="true">
      <source media="(max-width: 899px)" srcset="/hero-horizon-1280.webp" />
      <img src="/hero-horizon.webp" alt="" width="2560" height="1441" fetchpriority="high" />
    </picture>

    <h1 class="story-title">
      Your agents, your data, any provider.<br />Nothing extra.
    </h1>

    <div class="demo-window" data-demo-window>
      <aside class="demo-sidebar" aria-label="Chats in this demo">
        <div class="demo-brand"><img src="/icon.webp" alt="" width="18" height="18" /></div>

        <div class="sidebar-group">
          <div class="sidebar-item"><Fragment set:html={svg("search")} /><span>Search</span><kbd>⌘K</kbd></div>
          <div class="sidebar-item"><Fragment set:html={svg("tasks")} /><span>Tasks</span></div>
          <div class="sidebar-item"><Fragment set:html={svg("agents")} /><span>Agents</span></div>
          <div class="sidebar-item"><Fragment set:html={svg("automations")} /><span>Automations</span></div>
        </div>

        <div class="sidebar-label">Projects <Fragment set:html={svg("chevron")} /></div>
        <div class="sidebar-item is-muted-active"><span class="project-mark all" aria-hidden="true"></span><span>All projects</span></div>
        {projects.map((project) => (
          <div class="sidebar-item">
            <b class={`project-mark ${project.tone}`}>{project.mark}</b>
            <span>{project.name}</span>
          </div>
        ))}

        <div class="sidebar-label">Chats <Fragment set:html={svg("chevron")} /></div>
        <nav class="chat-list">
          {chats.map((chat, index) => (
            <button
              type="button"
              class:list={["chat-row", { "is-active": index === 0 }]}
              data-chat-target={index}
              data-title={chat.title}
              data-model={chat.model}
              data-project={chat.project ? JSON.stringify(chat.project) : ""}
              aria-current={index === 0 ? "true" : "false"}
            >
              {chat.project ? (
                <b class={`project-mark ${chat.project.tone}`}>{chat.project.mark}</b>
              ) : (
                <span class="project-mark none" aria-hidden="true"><Fragment set:html={svg("noProject")} /></span>
              )}
              {chat.status && <em class="chat-status">{chat.status}</em>}
              <span class="chat-name">{chat.title}</span>
              <time>{chat.meta}</time>
            </button>
          ))}
        </nav>

        <div class="sidebar-foot sidebar-item"><Fragment set:html={svg("settings")} /><span>Settings</span></div>
      </aside>

      <div class="demo-main">
        <header class="demo-header">
          <span class="demo-header-toggle">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path class="filled" d={panelIconPath}></path></svg>
          </span>
          <nav class="demo-tabs" aria-label="Chats in this demo">
            {chats.map((chat, index) => (
              <button
                type="button"
                class:list={["demo-tab", { "is-active": index === 0 }]}
                data-tab-target={index}
                aria-current={index === 0 ? "true" : "false"}
              >
                <span class="demo-tab-title">{chat.title}</span>
                <span class="demo-tab-close" aria-hidden="true"><Fragment set:html={svg("close")} /></span>
              </button>
            ))}
          </nav>
          <span class="demo-header-title" data-chat-title>{first.title}</span>
          <span class="demo-header-action"><Fragment set:html={svg("compose")} /></span>
        </header>

        <div class="demo-panes">
          <article class="chat-pane is-revealed" data-chat="0">
            <div class="msg msg-user" style="--i:0"><p>How does Up.computer work?</p></div>
            <div class="msg msg-agent" style="--i:1">
              <p>It’s one home for the agent CLIs you already have. Install Claude Code, Codex, Grok Build, OpenCode or Cursor, and each one runs on your own subscription. No new plan, no lock-in.</p>
              <div class="harness-row">
                <span class="harness-chip"><img src="/harnesses/claude-ai-icon.svg" alt="" />Claude Code</span>
                <span class="harness-chip"><img src="/harnesses/openai_dark.svg" alt="" />Codex</span>
                <span class="harness-chip"><img src="/harnesses/grok-dark.svg" alt="" />Grok Build</span>
                <span class="harness-chip"><img src="/harnesses/opencode-dark.svg" alt="" />OpenCode</span>
                <span class="harness-chip"><img src="/harnesses/cursor_light.svg" alt="" />Cursor</span>
              </div>
            </div>
            <div class="msg msg-agent" style="--i:2">
              <p>On top sits a flexible orchestration layer. Talk a task through, drop it in the backlog, and agents pick it up in the background. When they need to see the screen, they use the browser or your computer.</p>
            </div>
          </article>

          <article class="chat-pane" data-chat="1" hidden>
            <div class="msg msg-user" style="--i:0"><p>How should I use tasks? I keep losing track of my threads.</p></div>
            <div class="msg msg-agent" style="--i:1">
              <p>Stop treating threads as tasks. Talk ideas through with me here, and I’ll turn each one into a task for a worker agent. While it runs, move on to the next idea. Next time, just ask me what got done.</p>
            </div>
            <div class="msg msg-user" style="--i:2">
              <p>Okay. I want one place that compares every agent CLI. Run it in the background on GLM 5.3 Flash, one task at a time, low priority.</p>
            </div>
            <div class="msg msg-agent" style="--i:3">
              <p>Done. One agent, four tasks in the backlog.</p>
              <div class="card agent-card">
                <span class="card-icon"><Fragment set:html={svg("agents")} /></span>
                <span class="card-main"><strong>CLI researcher</strong><small>OpenCode · GLM 5.3 Flash · one task at a time</small></span>
              </div>
              <div class="card task-card">
                <div class="task-row"><span>Collect Claude Code features and limits</span><em>Low</em></div>
                <div class="task-row"><span>Collect Codex features and limits</span><em>Low</em></div>
                <div class="task-row"><span>Collect Grok Build features and limits</span><em>Low</em></div>
                <div class="task-row"><span>Put it all in one comparison</span><em>Low</em></div>
              </div>
            </div>
            <div class="msg msg-agent" style="--i:4">
              <p>By the way, two of your tasks are ready for review:</p>
              <ul class="result-list">
                <li><span class="result-icon ok"><Fragment set:html={svg("check")} /></span><span>Sample library sorted by key and BPM</span><small>Claude</small></li>
                <li><span class="result-icon ok"><Fragment set:html={svg("check")} /></span><span>Landing page copy, second review</span><small>Codex</small></li>
              </ul>
            </div>
            <div class="msg msg-user" style="--i:5"><p>Merge them.</p></div>
            <div class="msg msg-agent" style="--i:6">
              <p>Both merged. I’ll tell you when the comparison is ready.</p>
            </div>
          </article>

          <article class="chat-pane" data-chat="2" hidden>
            <div class="msg msg-user" style="--i:0"><p>Where do my chats live? Can other agents read them?</p></div>
            <div class="msg msg-agent" style="--i:1">
              <p>On your computer, in one local database: every chat with every agent, in one place. It isn’t tied to any provider, so any agent you connect can search it, summarize it, or turn it into something new.</p>
            </div>
            <div class="msg msg-user" style="--i:2"><p>Which projects took most of my time this month?</p></div>
            <div class="msg msg-agent" style="--i:3">
              <div class="work-row"><Fragment set:html={svg("database")} /><span>Read local history · 214 chats across 4 agents</span></div>
              <ul class="share-list">
                <li><span>Studio</span><i style="--share:41%"></i><small>41%</small></li>
                <li><span>Website</span><i style="--share:27%"></i><small>27%</small></li>
                <li><span>Research</span><i style="--share:18%"></i><small>18%</small></li>
              </ul>
              <p>Studio mostly went to mix prep. Want me to turn the repeated steps into a template?</p>
            </div>
          </article>

          <article class="chat-pane" data-chat="3" hidden>
            <div class="msg msg-user" style="--i:0">
              <p>Set up a new Ableton Live template: four audio tracks, a Drum Rack, and my usual chain on the master.</p>
            </div>
            <div class="msg msg-agent" style="--i:1">
              <div class="work-row"><Fragment set:html={svg("cursor")} /><span>Computer use · opened Ableton Live</span></div>
              <div class="work-row"><Fragment set:html={svg("cursor")} /><span>Created four audio tracks and a Drum Rack</span></div>
              <div class="work-row"><Fragment set:html={svg("cursor")} /><span>Master: EQ Eight → Glue Compressor → Limiter</span></div>
              <div class="work-row"><Fragment set:html={svg("cursor")} /><span>Saved the set as a template</span></div>
            </div>
            <div class="msg msg-agent" style="--i:2">
              <p>Your template “Mix start” is ready. It opens with every new set from now on.</p>
            </div>
          </article>

          <article class="chat-pane" data-chat="4" hidden>
            <div class="msg msg-user" style="--i:0"><p>How is this different from Claude Cowork or the Codex app?</p></div>
            <div class="msg msg-agent" style="--i:1">
              <p>Those are great if you only ever use one provider. Up.computer stays neutral: bring any agent, switch per task, and keep one history that belongs to you.</p>
            </div>
            <div class="msg msg-agent" style="--i:2">
              <p>It also stays small. No feed, no upsell: just your chats, your tasks and the agents you set up.</p>
            </div>
          </article>

          <article class="chat-pane" data-chat="5" hidden>
            <div class="msg msg-user" style="--i:0"><p>What does it cost?</p></div>
            <div class="msg msg-agent" style="--i:1">
              <p>The app is free. You keep paying your providers what you pay them today: Up.computer doesn’t resell models or add a markup.</p>
              <a
                class="card download-card"
                href="/download"
                data-analytics-event="marketing_download_cta_clicked"
                data-analytics-placement="homepage_story"
              >
                <img src="/icon.webp" alt="" width="32" height="32" />
                <span class="card-main"><strong>Download Up.computer</strong><small>macOS · Windows · Linux</small></span>
              </a>
            </div>
          </article>
        </div>

        <div class="demo-composer" aria-hidden="true">
          <div class="composer">
            <div class="composer-placeholder">Ask anything, @tag files/folders, $use skills, or / for commands</div>
            <div class="composer-toolbar">
              <div class="composer-options">
                <span class="composer-plus">＋</span><i></i><span>Build</span><i></i><span data-chat-model>{first.model}</span><i></i><span>Medium</span><i></i><span>Full access</span>
              </div>
              <span class="composer-send">
                <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M7 11.5V2.5M7 2.5 3 6.5M7 2.5l4 4"></path></svg>
              </span>
            </div>
          </div>
          <div class="context-bar">
            <span class="context-project" data-chat-project>Select project</span>
            <span class="context-toggle">
              <svg viewBox="0 0 16 16" aria-hidden="true"><path class="filled" d={panelIconPath}></path></svg>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="../scripts/story.ts"></script>

<style>
  .story {
    --lift: 0;
    --start-y: 30vh;
    --start-scale: 0.82;
    position: relative;
    height: calc(100vh + var(--steps) * 72vh);
  }

  .story-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  .story-bg {
    position: absolute;
    inset: 0;
  }

  .story-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .story-bg::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 24vh;
    background: linear-gradient(to bottom, transparent, var(--bg));
  }

  .story-title {
    position: absolute;
    top: 19vh;
    left: 0;
    right: 0;
    margin: 0 auto;
    padding: 0 24px;
    color: #fff;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: -0.005em;
    text-align: center;
    opacity: calc(1 - var(--lift) * 1.8);
  }

  /* ── Window ───────────────────────────────────────────────── */
  .demo-window {
    --app-muted: rgba(255, 255, 255, 0.5);
    --app-text: rgba(255, 255, 255, 0.86);
    --app-border: rgba(255, 255, 255, 0.07);
    --viewport: 100vh;
    --window-height: min(760px, calc(var(--viewport) - 108px));
    position: absolute;
    /* Lifted, the window is centered in the viewport but stays clear of the
       fixed nav (57px tall). story.ts reads this top for the lift start. */
    top: max(72px, calc((var(--viewport) - var(--window-height)) / 2));
    left: 0;
    right: 0;
    width: min(1180px, calc(100vw - 64px));
    height: var(--window-height);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 252px minmax(0, 1fr);
    overflow: hidden;
    border-radius: 12px;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.06),
      0 40px 90px -30px rgba(0, 0, 0, 0.85);
    color: var(--app-text);
    font-size: 14px;
    line-height: 1.6;
    text-align: left;
    transform-origin: top center;
    transform: translateY(calc(var(--start-y) * (1 - var(--lift))))
      scale(calc(var(--start-scale) + (1 - var(--start-scale)) * var(--lift)));
    will-change: transform;
  }

  .demo-window :global(svg) {
    width: 16px;
    height: 16px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ── Sidebar ──────────────────────────────────────────────── */
  .demo-sidebar {
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: 0 8px 10px;
    border-right: 1px solid var(--app-border);
    /* Glass like the app's sidebar: the backdrop shows through, blurred.
       Opaque enough that text keeps the contrast of the solid fallback. */
    background:
      linear-gradient(to bottom, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.02)),
      rgba(19, 19, 19, 0.78);
    -webkit-backdrop-filter: blur(28px) saturate(1.25);
    backdrop-filter: blur(28px) saturate(1.25);
  }

  @supports not ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
    .demo-sidebar {
      background:
        linear-gradient(to bottom, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.02)),
        rgba(35, 28, 31, 0.9);
    }
  }

  .demo-brand {
    height: 44px;
    padding: 0 8px;
    display: flex;
    align-items: center;
  }

  .demo-brand img {
    width: 18px;
    height: 18px;
    border-radius: 4px;
  }

  .sidebar-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 12px;
  }

  .sidebar-item {
    height: 30px;
    padding: 0 8px;
    display: flex;
    align-items: center;
    gap: 9px;
    border-radius: 8px;
    color: rgba(255, 255, 255, 0.82);
    white-space: nowrap;
  }

  .sidebar-item :global(svg) {
    color: var(--app-muted);
  }

  .sidebar-item kbd {
    margin-left: auto;
    color: var(--app-muted);
    font-family: inherit;
    font-size: 12px;
  }

  .sidebar-item.is-muted-active {
    background: rgba(255, 255, 255, 0.05);
  }

  .sidebar-label {
    height: 30px;
    margin-top: 6px;
    padding: 0 8px;
    display: flex;
    align-items: center;
    gap: 4px;
    color: var(--app-muted);
    font-size: 13px;
  }

  .sidebar-label :global(svg) {
    width: 13px;
    height: 13px;
  }

  /* Global so the context bar's script-rendered project mark is styled too. */
  .demo-window :global(.project-mark) {
    width: 16px;
    height: 16px;
    display: inline-grid;
    place-items: center;
    flex: none;
    border-radius: 4px;
    font-size: 9px;
    font-weight: 600;
    font-style: normal;
  }

  .demo-window :global(.project-mark.orange) { color: #ff9f43; background: rgba(255, 159, 67, 0.18); }
  .demo-window :global(.project-mark.purple) { color: #ad85ff; background: rgba(173, 133, 255, 0.18); }
  .demo-window :global(.project-mark.mint) { color: #72dfc2; background: rgba(114, 223, 194, 0.18); }
  .demo-window :global(.project-mark.none) { color: var(--app-muted); }
  .demo-window :global(.project-mark.none svg) {
    width: 14px;
    height: 14px;
  }
  .demo-window :global(.project-mark.all) {
    background:
      linear-gradient(rgba(255, 255, 255, 0.25) 0 0) 2px 2px / 5px 5px no-repeat,
      linear-gradient(rgba(255, 255, 255, 0.25) 0 0) 9px 2px / 5px 5px no-repeat,
      linear-gradient(rgba(255, 255, 255, 0.25) 0 0) 2px 9px / 5px 5px no-repeat,
      linear-gradient(rgba(255, 255, 255, 0.25) 0 0) 9px 9px / 5px 5px no-repeat;
  }

  .chat-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-height: 0;
  }

  .chat-row {
    width: 100%;
    height: 30px;
    padding: 0 8px;
    display: flex;
    align-items: center;
    gap: 8px;
    border-radius: 8px;
    color: rgba(255, 255, 255, 0.72);
