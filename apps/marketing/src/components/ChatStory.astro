// The attributes story.ts reads to fill the task page.
const taskAttrs = (task: DemoTask, audience: "Workers" | "Me") => ({
  "data-task": task.id,
  "data-status": task.status,
  "data-for": audience,
  "data-tags": task.tags.join(","),
  "data-description": task.description,
  "data-output": task.output,
  "data-runs": task.runs.map((run) => `${run.worker}:${run.state}`).join("|"),
});

const completedRuns = (task: DemoTask) =>
  task.runs.filter((run) => run.state === "Completed").length;

const workingRuns = (task: DemoTask) =>
  task.runs.filter((run) => run.state === "Working").length;

// The Workers list, newest first, grouped by status as in the app: its groups
// in their default order, Done and Cancelled collapsed. The panel shows it as
// cards; the Tasks page as a table, and as the same cards in a narrow window.
const panelTasks = [newTask, storyTaskTwo, storyTaskOne, ...workerTasks];
const statusGroups = [
  "Needs Input",
  "Needs Review",
  "In Review",
  "In Progress",
  "To Do",
  "Backlog",
  "Blocked",
  "Idea",
  "Done",
  "Cancelled",
];
const collapsedGroups = ["Done", "Cancelled"];

// The story's two tasks before its end: the panel views (data-view) in which
// the task already exists, its status in them and its working runs.
const storyStates: Record<string, { views: string[]; status: string; working: number }> = {
  [storyTaskOne.id]: { views: ["one", "two"], status: "In Progress", working: 1 },
  [storyTaskTwo.id]: { views: ["two"], status: "To Do", working: 0 },
};

const groupedTasks = statusGroups.map((status) => {
  const tasks = panelTasks.filter((task) => task.status === status);
  return {
    status,
    tasks,
    count: tasks.filter((task) => task !== newTask).length,
    open: !collapsedGroups.includes(status),
  };
});

// What a card or a table row of a grouped list carries for story.ts: its
// place in the list's order and, for the story's tasks, "view:status" pairs.
const groupedAttrs = (task: DemoTask) => ({
  "data-rank": panelTasks.indexOf(task),
  "data-story": storyStates[task.id]?.views
    .map((view) => `${view}:${storyStates[task.id]!.status}`)
    .join("|"),
  "data-new-task": task === newTask ? "" : undefined,
  ...taskAttrs(task, "Workers"),
  hidden: task === newTask,
});

