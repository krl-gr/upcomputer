---
import HorizonBackdrop from "./HorizonBackdrop.astro";

/**
 * Homepage hero: a pinned replica of the Up.computer window; each scroll step
 * opens the next chat. Wide screens add the Tasks panel on the right, small
 * screens show the chats as top thread tabs. A click on any control in the
 * window ends the scroll story and lets the visitor explore (story.ts).
 */

