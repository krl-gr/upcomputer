<script src="../scripts/story.ts"></script>

<style>
  .story {
    --lift: 0;
    --start-y: 30vh;
    --start-scale: 0.82;
    /* The window's lifted place; the hint below it follows the same numbers. */
    --viewport: 100vh;
    --window-height: min(760px, calc(var(--viewport) - 108px));
    --window-top: max(72px, calc((var(--viewport) - var(--window-height)) / 2));
    position: relative;
    /* Estimate until story.ts sets the height from the message count. */
    height: calc(100vh + var(--steps) * 105vh);
  }

  .story-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    /* The window's content changes under a pinned stage; without this the
       browser's scroll anchoring moves the page a few px each time. */
    overflow-anchor: none;
  }

  .story-bg {
    position: absolute;
    inset: 0;
  }

  .story-bg::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 24vh;
    background: linear-gradient(to bottom, transparent, var(--bg));
  }

  .story-title {
    position: absolute;
    top: 19vh;
    left: 0;
    right: 0;
    margin: 0 auto;
    padding: 0 24px;
    color: #fff;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: -0.005em;
    text-align: center;
    text-wrap: balance;
    opacity: calc(1 - var(--lift) * 1.8);
  }

  /* One block per line, so each line balances on its own when it wraps. */
  .story-title span {
    display: block;
  }

  /* ── Window ───────────────────────────────────────────────── */
  .demo-window {
    /* The theme: every text and line color is the ink at some strength. */
    --ink: 255, 255, 255;
    --app-bg: #131313;
    --app-raised: #1e1e1e;
    --app-sidebar: rgba(19, 19, 19, 0.78);
    --app-working: #38bdf8;
    --app-completed: rgba(110, 231, 183, 0.9);
    --app-send: #d4d4d4;
    --app-send-ink: #171717;
    --app-muted: rgba(var(--ink), 0.5);
    --app-text: rgba(var(--ink), 0.86);
    --app-border: rgba(var(--ink), 0.07);
    position: absolute;
    /* Lifted, the window is centered in the viewport but stays clear of the
       fixed nav (57px tall). story.ts reads this top for the lift start. */
    top: var(--window-top);
    left: 0;
    right: 0;
    width: min(1240px, calc(100vw - 64px));
    height: var(--window-height);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr) 348px;
    overflow: hidden;
    border-radius: 12px;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.06),
      0 40px 90px -30px rgba(0, 0, 0, 0.85);
    color: var(--app-text);
    font-size: 14px;
    line-height: 1.6;
    text-align: left;
    transform-origin: top center;
    transform: translateY(calc(var(--start-y) * (1 - var(--lift))))
      scale(calc(var(--start-scale) + (1 - var(--start-scale)) * var(--lift)));
    will-change: transform;
  }

  .demo-window :global(svg) {
    width: 16px;
    height: 16px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* What the "Switch to Solarized" suggestion turns on: Solarized dark. */
  .demo-window[data-theme="solarized"] {
    --ink: 170, 181, 180;
    --app-bg: #002b36;
    --app-raised: #073642;
    --app-sidebar: rgba(0, 33, 43, 0.9);
    --app-working: #268bd2;
    --app-completed: #859900;
    --app-send: #93a1a1;
    --app-send-ink: #002b36;
    --app-muted: #6f8990;
  }

  .demo-main,
  .demo-sidebar,
  .demo-panel,
  .composer {
    transition: background-color 0.4s ease;
  }

  .demo-window :global(button) {
    font: inherit;
    letter-spacing: inherit;
    text-align: left;
  }

  /* The window clips its content, so focus rings sit inside the controls. */
  .demo-window :global(button:focus-visible),
  .demo-window :global(a:focus-visible),
  .demo-window :global(summary:focus-visible),
  .demo-window :global(input:focus-visible) {
    outline-offset: -2px;
    border-radius: 8px;
  }

  .demo-window :global([hidden]) {
    display: none !important;
  }

  /* ── Sidebar ──────────────────────────────────────────────── */
  .demo-sidebar {
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: 0 8px;
    border-right: 1px solid var(--app-border);
    /* Glass like the app's sidebar: the backdrop shows through, blurred.
       Opaque enough that text keeps the contrast of the solid fallback. */
    background:
      linear-gradient(to bottom, rgba(var(--ink), 0.05), rgba(var(--ink), 0.02)),
      var(--app-sidebar);
    -webkit-backdrop-filter: blur(28px) saturate(1.25);
    backdrop-filter: blur(28px) saturate(1.25);
  }

  @supports not ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
    .demo-sidebar {
      background:
        linear-gradient(to bottom, rgba(var(--ink), 0.05), rgba(var(--ink), 0.02)),
        rgba(35, 28, 31, 0.9);
    }
  }

  /* The macOS window buttons, as in the desktop app. */
  .demo-lights {
    height: 44px;
    flex: none;
    padding: 0 8px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .demo-lights i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #ff5f57;
  }

  .demo-lights i:nth-child(2) { background: #febc2e; }
  .demo-lights i:nth-child(3) { background: #28c840; }

  /* Everything between the window buttons and the icon row. It never
     scrolls: shorter windows drop rows instead (see the height queries). */
  .sidebar-scroll {
    min-height: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .sidebar-group {
    display: flex;
    flex: none;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 6px;
  }

  .sidebar-item {
    height: 30px;
    flex: none;
    padding: 0 8px;
    display: flex;
    align-items: center;
    gap: 9px;
    border-radius: 8px;
    color: rgba(var(--ink), 0.82);
    white-space: nowrap;
  }

  .sidebar-item :global(svg) {
    color: var(--app-muted);
  }

  .sidebar-item.is-muted-active {
    background: rgba(var(--ink), 0.05);
  }

  /* Bots and the pinned thread open a chat, like the thread rows below. */
  button.sidebar-item {
    width: 100%;
    transition: background 0.18s ease, color 0.18s ease;
  }

  button.sidebar-item:hover {
    background: rgba(var(--ink), 0.035);
    color: rgba(var(--ink), 0.9);
  }

  button.sidebar-item.is-active {
    background: rgba(var(--ink), 0.07);
    color: rgb(var(--ink));
  }

  .sidebar-item[data-new-bot] {
    animation: task-arrive 0.5s ease both;
  }

  .sidebar-label {
    height: 30px;
    flex: none;
    margin-top: 6px;
    padding: 0 8px;
    display: flex;
    align-items: center;
    gap: 4px;
    color: var(--app-muted);
    font-size: 13px;
  }

  .sidebar-label :global(svg) {
    width: 13px;
    height: 13px;
  }

  .sidebar-bot {
    gap: 8px;
  }

  /* The bot character: its own colors, no icon stroke. */
  .demo-window :global(svg.bot-char) {
    width: 24px;
    height: 24px;
    margin: 0 -4px;
    stroke: none;
  }

  .sidebar-pinned {
    display: flex;
    flex: none;
    flex-direction: column;
  }

  .sidebar-thread {
    gap: 8px;
    color: rgba(var(--ink), 0.72);
  }

  .sidebar-thread time {
    flex: none;
    color: var(--app-muted);
    font-size: 13px;
  }

  /* Global so the header's script-rendered project mark is styled too. */
  .demo-window :global(.project-mark) {
    width: 18px;
    height: 18px;
    display: inline-grid;
    place-items: center;
    flex: none;
    border-radius: 5px;
    font-size: 8px;
    font-weight: 700;
    font-style: normal;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .demo-window :global(.project-mark.orange) { color: #ff9f43; background: rgba(255, 159, 67, 0.18); }
  .demo-window :global(.project-mark.purple) { color: #ad85ff; background: rgba(173, 133, 255, 0.18); }
  .demo-window :global(.project-mark.mint) { color: #72dfc2; background: rgba(114, 223, 194, 0.18); }
  .demo-window :global(.project-mark.none) { color: var(--app-muted); }
  .demo-window :global(.project-mark.empty) { background: rgba(var(--ink), 0.12); }
  .demo-window :global(.project-mark.none svg) {
    width: 14px;
    height: 14px;
  }
  .demo-window :global(.project-mark.all) {
    background:
      linear-gradient(rgba(var(--ink), 0.25) 0 0) 2px 2px / 6px 6px no-repeat,
      linear-gradient(rgba(var(--ink), 0.25) 0 0) 10px 2px / 6px 6px no-repeat,
      linear-gradient(rgba(var(--ink), 0.25) 0 0) 2px 10px / 6px 6px no-repeat,
      linear-gradient(rgba(var(--ink), 0.25) 0 0) 10px 10px / 6px 6px no-repeat;
  }

  .chat-list {
    display: flex;
    flex: none;
    flex-direction: column;
    gap: 2px;
  }

  .chat-row {
    width: 100%;
    height: 30px;
    padding: 0 8px;
    display: flex;
    align-items: center;
    gap: 8px;
    border-radius: 8px;
    color: rgba(var(--ink), 0.72);
    font-size: 14px;
    text-align: left;
    transition: background 0.18s ease, color 0.18s ease;
  }

  .chat-row:hover {
    background: rgba(var(--ink), 0.035);
    color: rgba(var(--ink), 0.9);
  }

  .chat-row.is-active {
    background: rgba(var(--ink), 0.07);
    color: rgb(var(--ink));
  }

  .chat-name {
    min-width: 0;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .chat-status {
    flex: none;
    color: var(--app-working);
    font-style: normal;
  }

  .chat-row time {
    flex: none;
    color: var(--app-muted);
    font-size: 13px;
  }

  /* Task run counts, like the app's thread accessory: they take the place
     of the row's time, one number per run status in its status color. */
  .demo-window :global(.run-counts) {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    opacity: 0.8;
  }

  .demo-window :global(.run-counts[hidden]),
  .demo-window :global(.run-counts > [hidden]) {
    display: none;
  }

  .demo-window :global(.run-working) {
    color: var(--app-working);
  }

  .demo-window :global(.run-completed) {
    color: var(--app-completed);
  }

  .nav-run-counts {
    margin-left: auto;
  }

  /* The icon row at the bottom: settings, bots, usage, notifications. */
  .sidebar-foot {
    height: 44px;
    flex: none;
    padding: 0 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--app-muted);
  }

  .foot-btn {
    width: 28px;
    height: 28px;
    margin: 0 -6px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    transition: background 0.18s ease, color 0.18s ease;
  }

  button.foot-btn:hover,
  button.foot-btn.is-active {
    background: rgba(var(--ink), 0.07);
    color: rgba(var(--ink), 0.9);
  }

  .switch {
    width: 32px;
    height: 18px;
    padding: 2px;
    display: flex;
    flex: none;
    border-radius: 999px;
    background: rgba(var(--ink), 0.18);
    transition: background 0.18s ease;
  }

  .switch::after {
    content: "";
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: rgba(var(--ink), 0.6);
    transition: transform 0.18s ease, background 0.18s ease;
  }

  [aria-checked="true"] > .switch {
    background: #2f6bff;
  }

  [aria-checked="true"] > .switch::after {
    background: var(--app-bg);
    transform: translateX(14px);
  }

  /* The "+" on the Bots label opens the bot creation page. */
  .label-btn {
    width: 22px;
    height: 22px;
    margin-left: auto;
    display: grid;
    place-items: center;
    border-radius: 6px;
    color: var(--app-muted);
    transition: background 0.18s ease, color 0.18s ease;
  }

  .label-btn:hover {
    background: rgba(var(--ink), 0.07);
    color: rgba(var(--ink), 0.9);
  }

  .demo-window .label-btn:focus-visible {
    border-radius: 6px;
  }

  /* Exploring, a long sidebar scrolls like the app's. */
  .story.is-exploring .sidebar-scroll {
    overflow-y: auto;
    scrollbar-width: none;
  }

  .sidebar-scrim {
    display: none;
  }

  /* Shorter windows keep the threads in view and drop other rows first. */
  @media (max-height: 871px) {
    .sidebar-more,
    .sidebar-bot.is-last {
      display: none;
    }
  }

  @media (max-height: 811px) {
    .sidebar-pinned {
      display: none;
    }
  }

  @media (max-height: 745px) {
    .sidebar-bot.is-later {
      display: none;
    }
  }

  /* ── Main column ──────────────────────────────────────────── */
  .demo-main {
    position: relative;
    min-width: 0;
    background: var(--app-bg);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .demo-header {
    height: 44px;
    flex: none;
    padding: 0 16px 0 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: rgba(var(--ink), 0.92);
  }

  /* The thread's project, a slash and its title. */
  .demo-header-crumb {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .demo-header-crumb i {
    color: var(--app-muted);
    font-style: normal;
  }

  .demo-header-project {
    display: inline-flex;
    flex: none;
  }

  .demo-header-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .demo-header-actions {
    display: flex;
    flex: none;
    align-items: center;
    gap: 14px;
    color: var(--app-muted);
  }

  /* With the panel open, its own header carries the toggle. */
  .demo-header-panel-toggle {
    display: none;
  }

  /* Small screens only: the sidebar toggle and the thread tabs. */
  .demo-header-toggle,
  .demo-tabs {
    display: none;
  }

  .demo-panes {
    position: relative;
    min-height: 0;
    flex: 1;
  }

  .chat-pane {
    position: absolute;
    inset: 0;
    overflow: hidden;
    padding: 20px max(24px, calc((100% - 720px) / 2)) 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    mask-image: linear-gradient(to bottom, transparent, #000 24px, #000 calc(100% - 24px), transparent);
  }

  .chat-pane[hidden] {
    display: none;
  }

  /* Exploring, the visitor scrolls a chat by hand; the story no longer does. */
  .story.is-exploring .chat-pane {
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(var(--ink), 0.14) transparent;
  }

  /* ── Bot chats: a glimpse of the bot page, then its chat ──── */
  .bot-intro {
    flex: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-bottom: 4px;
  }

  .bot-id {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .demo-window .bot-id :global(svg.bot-char),
  .demo-window .bot-card :global(svg.bot-char) {
    width: 44px;
    height: 44px;
    margin: 0;
  }

  /* The bot page's Memory section: one row per fact, its age below. */
  .bot-memory {
    border: 1px solid var(--app-border);
    border-radius: 12px;
    background: rgba(var(--ink), 0.02);
  }

  .bot-memory-title {
    padding: 9px 14px 7px;
    border-bottom: 1px solid var(--app-border);
    color: var(--app-muted);
    font-size: 13px;
  }

  .memory-row {
    padding: 8px 14px;
    display: flex;
    flex-direction: column;
    line-height: 1.45;
  }

  .memory-row + .memory-row {
    border-top: 1px solid var(--app-border);
  }

  .memory-row small,
  .memory-empty {
    color: var(--app-muted);
    font-size: 12px;
  }

  .memory-empty {
    padding: 10px 14px;
    font-size: 13px;
  }

  .bullet-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-left: 22px;
  }

  .bullet-list li::marker {
    color: var(--app-muted);
  }

  .bot-card {
    align-self: flex-start;
    padding: 8px 16px 8px 10px;
    transition: border-color 0.18s ease, background 0.18s ease;
  }

  .bot-card:hover {
    border-color: rgba(var(--ink), 0.16);
    background: rgba(var(--ink), 0.04);
  }

  /* The pause before a scripted reply. */
  .msg-working i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
    animation: pulse 1s ease-in-out infinite;
  }

  .msg-working i:nth-child(2) { animation-delay: 0.15s; }
  .msg-working i:nth-child(3) { animation-delay: 0.3s; }
  .msg-working .work-row { gap: 4px; }
  .msg-working i:first-child { margin-left: 4px; }

  .msg {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.45s ease,
      transform 0.45s ease;
  }

  .msg.is-shown {
    opacity: 1;
    transform: none;
  }

  .msg p + p,
  .msg p + .harness-row,
  .msg .harness-row + p {
    margin-top: 10px;
  }

  .chat-link {
    text-decoration: underline;
    text-decoration-color: rgba(var(--ink), 0.35);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s ease;
  }

  .chat-link:hover,
  .chat-link:focus-visible {
    text-decoration-color: rgb(var(--ink));
  }

  .step-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-left: 22px;
  }

  .step-list li::marker {
    color: var(--app-muted);
  }

  .msg-user {
    align-self: flex-end;
    max-width: 80%;
    padding: 10px 16px;
    border: 1px solid rgba(var(--ink), 0.06);
    border-radius: 16px 16px 4px 16px;
    background: rgba(var(--ink), 0.04);
    color: rgba(var(--ink), 0.92);
  }

  .msg-agent {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .msg-note {
    color: var(--app-muted);
  }

  .harness-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .harness-chip {
    height: 28px;
    padding: 0 10px 0 8px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 1px solid var(--app-border);
    border-radius: 999px;
    background: rgba(var(--ink), 0.025);
    color: rgba(var(--ink), 0.82);
    font-size: 13px;
  }

  .harness-chip img {
    width: 14px;
    height: 14px;
    object-fit: contain;
  }

  .result-list,
  .share-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .result-list li {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .result-list li > span:nth-child(2) {
    flex: 1;
    min-width: 0;
  }

  .result-list small,
  .share-list small {
    color: var(--app-muted);
    font-size: 13px;
  }

  .result-icon {
    width: 18px;
    height: 18px;
    display: grid;
    place-items: center;
    flex: none;
    border-radius: 50%;
  }

  .result-icon :global(svg) {
    width: 12px;
    height: 12px;
    stroke-width: 2.4;
  }

  .result-icon.ok { color: #4ade80; background: rgba(74, 222, 128, 0.12); }
  .result-icon.warn { color: #fbbf24; background: rgba(251, 191, 36, 0.12); }

  .card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border: 1px solid var(--app-border);
    border-radius: 12px;
    background: rgba(var(--ink), 0.02);
  }

  .card-icon {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    flex: none;
    border-radius: 8px;
    background: rgba(var(--ink), 0.05);
    color: rgba(var(--ink), 0.7);
  }

  .card-main {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .card-main strong {
    color: rgba(var(--ink), 0.92);
    font-weight: 500;
  }

  .card-main small {
    color: var(--app-muted);
    font-size: 13px;
  }

  .task-card {
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    padding: 4px 14px;
  }

  .task-row {
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: rgba(var(--ink), 0.82);
  }

  .task-row + .task-row {
    border-top: 1px solid var(--app-border);
  }

  .task-row span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .task-row em {
    flex: none;
    color: var(--app-muted);
    font-size: 13px;
    font-style: normal;
  }

  .task-title {
    padding: 8px 0 6px;
    color: rgba(var(--ink), 0.92);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .task-kind {
    margin-right: 8px;
    color: var(--app-muted);
    font-weight: 400;
  }

  /* Runs of the task above, a step quieter than the task itself. */
  .task-title ~ .task-row {
    color: rgba(var(--ink), 0.66);
  }

  /* Same blue as the working run count on the thread. */
  .task-row em.is-working {
    color: var(--app-working);
    opacity: 0.8;
  }

  .work-row {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--app-muted);
    font-size: 13px;
  }

  .work-row :global(svg) {
    width: 14px;
    height: 14px;
  }

  .share-list li {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr) 36px;
    align-items: center;
    gap: 10px;
  }

  .share-list i {
    height: 6px;
    border-radius: 999px;
    background: linear-gradient(to right, rgba(var(--ink), 0.55) var(--share), rgba(var(--ink), 0.06) var(--share));
  }

  .download-card {
    align-self: flex-start;
    transition: border-color 0.18s ease, background 0.18s ease;
  }

  .download-card:hover {
    border-color: rgba(var(--ink), 0.16);
    background: rgba(var(--ink), 0.04);
  }

  .download-card img {
    width: 32px;
    height: 32px;
    border-radius: 8px;
  }

  /* ── Composer: the app's own sizes at its default 16px interface
     size (apps/web/src/composerFooter/composerLookStyles.ts) ──── */
  .demo-composer {
    flex: none;
    width: min(100% - 40px, 832px);
    margin: 0 auto 16px;
  }

  /* The composer takes no typing here. Hovering, focusing or tapping it swaps
     the placeholder for three things to try, as plain text on the same line. */
  .composer-line {
    position: relative;
    padding: 16px 16px 8px;
  }

  .composer-chips {
    position: absolute;
    inset: 14px 14px 6px;
    padding: 2px;
    display: flex;
    align-items: center;
    gap: 22px;
    overflow-x: auto;
    scrollbar-width: none;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease;
  }

  .composer-chips::-webkit-scrollbar {
    display: none;
  }

  .suggest-chip {
    flex: none;
    color: rgba(var(--ink), 0.72);
    transition: color 0.18s ease, opacity 0.18s ease;
  }

  .suggest-chip:hover {
    color: rgb(var(--ink));
  }

  .demo-window .suggest-chip:focus-visible {
    outline-offset: 1px;
    border-radius: 4px;
  }

  /* Shown for the keyboard, and after a tap where there is no hover. */
  .composer:has(.suggest-chip:focus-visible) .composer-chips,
  .composer.is-open .composer-chips {
    opacity: 1;
    pointer-events: auto;
  }

  .composer:has(.suggest-chip:focus-visible) .composer-placeholder,
  .composer.is-open .composer-placeholder {
    opacity: 0;
  }

  @media (hover: hover) {
    .composer:hover .composer-chips {
      opacity: 1;
      pointer-events: auto;
    }

    .composer:hover .composer-placeholder {
      opacity: 0;
    }
  }

  .composer-chips.is-busy .suggest-chip {
    opacity: 0.5;
    pointer-events: none;
  }

  /* 25px corners: the footer's 9px inset plus the 32px buttons' radius, so
     the paperclip and send sit concentric with the bottom corners. */
  .composer {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    border-radius: 25px;
    background: var(--app-raised);
    box-shadow:
      inset -1px -1px 1px rgba(var(--ink), 0.06),
      inset 1px 1px 1px rgba(var(--ink), 0.12),
      0 4px 14.4px rgba(9, 9, 9, 0.08);
    font-size: 14px;
    line-height: 1.625;
  }

  /* One prompt line, 16px from the top and sides and 8px above the footer. */
  .composer-placeholder {
    overflow: hidden;
    color: var(--app-muted);
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: opacity 0.18s ease;
  }

  /* The footer row: 32px controls, 9px from the sides and the bottom. */
  .composer-toolbar {
    padding: 0 9px 9px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    color: var(--app-muted);
  }

  .composer-options {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 2px;
    white-space: nowrap;
  }

  .composer-options > span {
    height: 32px;
    padding: 0 8px;
    display: inline-flex;
    flex: none;
    align-items: center;
  }

  .composer-options .composer-attach {
    width: 32px;
    justify-content: center;
  }

  /* The model label gives way first when the row is short of room. */
  .composer-options .composer-model {
    min-width: 0;
    flex: 0 1 auto;
    display: block;
    overflow: hidden;
    line-height: 32px;
    text-overflow: ellipsis;
  }

  .composer-access :global(svg) {
    display: none;
  }

  .composer-options i {
    width: 1px;
    height: 12px;
    flex: none;
    background: rgba(var(--ink), 0.06);
  }

  /* A narrow composer folds the access label to its lock, as the app does. */
  @container (max-width: 371px) {
    .composer-access > span {
      display: none;
    }

    .composer-access :global(svg) {
      display: block;
    }
  }

  .composer-send {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    flex: none;
    border-radius: 50%;
    background: var(--app-send);
    color: var(--app-send-ink);
    opacity: 0.4;
  }

  .composer-send svg {
    width: 14px;
    height: 14px;
  }

  /* ── Tasks panel (mirrors the app's right panel) ──────────── */
  .demo-panel {
    min-width: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;
    border-left: 1px solid var(--app-border);
    background: var(--app-bg);
    font-size: 13px;
    line-height: 1.4;
  }

  .panel-header {
    height: 44px;
    flex: none;
    padding: 0 10px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* One tab per open surface, then the "+" that lists the rest. */
  .panel-tabs {
    min-width: 0;
    flex: 1;
    display: flex;
    align-items: center;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .panel-tabs::-webkit-scrollbar {
    display: none;
  }

  .panel-tab-wrap {
    position: relative;
    display: inline-flex;
    flex: none;
  }

  .panel-tab {
    height: 28px;
    padding: 0 10px 0 8px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 8px;
    color: rgba(var(--ink), 0.72);
    font-size: 14px;
    white-space: nowrap;
    transition: background 0.18s ease, color 0.18s ease;
  }

  .panel-tab:hover {
    background: rgba(var(--ink), 0.04);
  }

  .panel-tab[aria-pressed="true"] {
    background: rgba(var(--ink), 0.07);
    color: rgba(var(--ink), 0.92);
  }

  .panel-tab-wrap:has(.panel-tab-close) .panel-tab {
    padding-right: 26px;
  }

  .panel-tab-close {
    position: absolute;
    top: 6px;
    right: 5px;
    width: 16px;
    height: 16px;
    display: grid;
    place-items: center;
    border-radius: 4px;
    color: var(--app-muted);
  }

  .panel-tab-close:hover {
    background: rgba(var(--ink), 0.1);
    color: rgb(var(--ink));
  }

  .demo-panel .panel-tab-close :global(svg) {
    width: 12px;
    height: 12px;
  }

  .demo-window .panel-tab-close:focus-visible {
    border-radius: 4px;
  }

  .panel-icon {
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    flex: none;
    border-radius: 8px;
    color: var(--app-muted);
    transition: background 0.18s ease, color 0.18s ease;
  }

  .panel-icon.is-on,
  button.panel-icon:hover,
  button.panel-icon[aria-expanded="true"] {
    background: rgba(var(--ink), 0.07);
    color: rgba(var(--ink), 0.82);
  }

  .panel-header-end {
    display: flex;
    flex: none;
    gap: 2px;
  }

  /* The "+" menu: every surface the app offers, with its key. */
  .surface-menu {
    position: absolute;
    top: 40px;
    left: 10px;
    z-index: 6;
    width: 208px;
    padding: 4px;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(var(--ink), 0.1);
    border-radius: 10px;
    background: var(--app-raised);
    box-shadow: 0 16px 40px -12px rgba(0, 0, 0, 0.7);
    font-size: 14px;
  }

  .menu-item {
    height: 32px;
    padding: 0 8px;
    display: flex;
    align-items: center;
    gap: 10px;
    border-radius: 6px;
    color: rgba(var(--ink), 0.9);
  }

  .menu-item:hover,
  .menu-item:focus-visible {
    background: rgba(var(--ink), 0.07);
  }

  .demo-window .menu-item:focus-visible {
    border-radius: 6px;
  }

  .menu-item > span {
    flex: 1;
  }

  .menu-item :global(svg) {
    color: var(--app-muted);
  }

  .demo-window :global(kbd) {
    min-width: 20px;
    padding: 1px 5px;
    border-radius: 5px;
    background: rgba(var(--ink), 0.07);
    color: var(--app-muted);
    font-family: var(--font-sans);
    font-size: 11px;
    line-height: 16px;
    text-align: center;
  }

  /* The open surface fills the panel; in Tasks, the story fades Me into Workers. */
  .panel-views {
    position: relative;
    min-height: 0;
    flex: 1;
  }

  .surface {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .panel-view {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: opacity 0.35s ease;
  }

  /* Hidden only once the fade is over; shown at once, so focus can move in. */
  .demo-window:not([data-side="me"]) .panel-view[data-side-view="me"],
  .demo-window[data-side="me"] .panel-view[data-side-view="workers"] {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.35s ease,
      visibility 0s 0.35s;
  }

  /* Each side shows one list: the one its Tasks/Routines switch picks. */
  .demo-window:not([data-kind="tasks"]) [data-side-view="me"] [data-list="tasks"],
  .demo-window:not([data-kind="routines"]) [data-side-view="me"] [data-list="routines"],
  .demo-window:not([data-wkind="tasks"]) [data-side-view="workers"] [data-list="tasks"],
  .demo-window:not([data-wkind="automations"]) [data-side-view="workers"] [data-list="automations"] {
    display: none;
  }

  .planner-head {
    height: 44px;
    flex: none;
    padding: 0 10px 0 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .planner-month {
    color: rgba(var(--ink), 0.92);
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
  }

  .planner-month small {
    color: var(--app-muted);
    font-size: inherit;
    font-weight: 400;
  }

  .planner-nav {
    display: flex;
    gap: 4px;
  }

  /* The app's small outline buttons and chips. */
  .chip-btn,
  .chip {
    height: 24px;
    min-width: 24px;
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    gap: 5px;
    border: 1px solid rgba(var(--ink), 0.1);
    border-radius: 7px;
    color: rgba(var(--ink), 0.72);
    font-size: 12px;
    white-space: nowrap;
  }

  .chip {
    padding: 0 6px;
  }

  .chip-btn.is-text {
    padding: 0 8px;
    color: rgba(var(--ink), 0.86);
  }

  .demo-window .chip-btn :global(svg),
  .demo-window .chip :global(svg) {
    width: 13px;
    height: 13px;
  }

  .demo-window .chip :global(.project-mark) {
    width: 16px;
    height: 16px;
    margin-left: -2px;
    font-size: 7px;
  }

  .planner-days {
    min-height: 0;
    flex: 1 1 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    overflow: hidden;
    border-top: 1px solid var(--app-border);
    border-bottom: 1px solid var(--app-border);
  }

  .planner-day {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .planner-day + .planner-day {
    border-left: 1px solid var(--app-border);
  }

  .planner-day-name {
    height: 30px;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--app-border);
    color: rgba(var(--ink), 0.92);
    font-size: 12px;
    font-weight: 500;
  }

  .planner-day-name small {
    margin-left: 6px;
    color: var(--app-muted);
    font-size: inherit;
    font-weight: 400;
  }

  .planner-blocks {
    padding: 6px 5px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .planner-block {
    --tone: 148, 163, 184;
    min-width: 0;
    padding: 5px 8px 6px 10px;
    display: flex;
    flex-direction: column;
    border-left: 3px solid rgb(var(--tone));
    border-radius: 5px;
    background: rgba(var(--tone), 0.14);
    color: rgba(var(--ink), 0.9);
    font-size: 12px;
  }

  .planner-block span,
  .planner-block small {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .planner-block small {
    color: var(--app-muted);
    font-size: 11px;
  }

  .planner-block.green { --tone: 52, 211, 153; }
  .planner-block.blue { --tone: 96, 165, 250; }
  .planner-block.purple { --tone: 167, 139, 250; }
  .planner-block.pink { --tone: 244, 114, 182; }
  .planner-block.cyan { --tone: 34, 211, 238; }
  .planner-block.amber { --tone: 251, 191, 36; }

  .panel-switches {
    height: 48px;
    flex: none;
    padding: 0 10px 0 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .panel-view[data-side-view="workers"] .panel-switches {
    border-bottom: 1px solid var(--app-border);
  }

  .panel-switches-end {
    margin-left: auto;
    display: flex;
    gap: 4px;
  }

  /* The app's segmented switch: one outline, the chosen side filled. */
  .segmented {
    height: 28px;
    padding: 2px;
    display: inline-flex;
    flex: none;
    border: 1px solid rgba(var(--ink), 0.1);
    border-radius: 9px;
    color: var(--app-muted);
  }

  .segmented > button {
    min-width: 26px;
    padding: 0 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    transition: background 0.18s ease, color 0.18s ease;
  }

  .segmented > button:hover {
    color: rgba(var(--ink), 0.82);
  }

  .segmented > button[aria-pressed="true"] {
    background: rgba(var(--ink), 0.09);
    color: rgba(var(--ink), 0.92);
  }

  .demo-window .segmented > button:focus-visible {
    border-radius: 6px;
  }

  .demo-window .segmented :global(svg) {
    width: 14px;
    height: 14px;
  }

  .panel-list {
    flex: none;
    padding: 6px 0 8px;
    display: flex;
    flex-direction: column;
  }

  .panel-view[data-side-view="workers"] .panel-list {
    min-height: 0;
    flex: 1;
  }

  /* The app's row: 8px from the list's sides, 12px padding, a rounded hover. */
  .panel-row {
    margin: 0 8px;
    padding: 12px;
    display: block;
    flex: none;
    border-radius: 12px;
  }

  button.panel-row {
    width: calc(100% - 16px);
    transition: background 0.18s ease;
  }

  button.panel-row:hover {
    background: rgba(var(--ink), 0.05);
  }

  .panel-row-title {
    display: block;
    overflow: hidden;
    color: rgba(var(--ink), 0.92);
    font-size: 14px;
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* The chips under the title: 8px below it, 4px apart, 4px out to the left. */
  .panel-row-chips {
    margin: 8px 0 0 -4px;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  /* The Workers list: the app's status groups. The list scrolls, with 8px
     above and below its groups; each group starts 8px below the one before.
     The 8px are not padding, so a sticky header reaches the list's top. */
  .panel-list.task-groups {
    padding: 0;
    overflow-y: auto;
    scrollbar-width: none;
  }

  .task-groups::before,
  .task-groups::after {
    content: "";
    height: 8px;
    flex: none;
  }

  .task-group {
    flex: none;
    padding-top: 8px;
  }

  /* The sidebar's section header: the title, its chevron right after it and
     the count at the right. It lines up with the cards' content on both sides
     and stays at the top while its cards scroll under it. */
  .task-group-head {
    position: sticky;
    top: 0;
    z-index: 1;
    height: 32px;
    padding: 0 20px 0 12px;
    display: flex;
    align-items: center;
    gap: 4px;
    background: var(--app-bg);
    color: var(--app-muted);
    font-size: 14px;
    transition: background-color 0.4s ease;
  }

  .task-group-toggle {
    min-width: 0;
    height: 100%;
    flex: 1;
    padding: 0 8px;
    display: flex;
    align-items: center;
    gap: 4px;
    border-radius: 6px;
    transition: color 0.18s ease;
  }

  .task-group-toggle:hover {
    color: rgba(var(--ink), 0.72);
  }

  .task-group-toggle span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .demo-window .task-group-toggle :global(svg) {
    width: 14px;
    height: 14px;
  }

  .demo-window .task-group-toggle[aria-expanded="true"] :global(svg) {
    transform: rotate(90deg);
  }

  .task-group-count {
    flex: none;
    font-variant-numeric: tabular-nums;
  }

  .task-group-cards {
    padding-top: 4px;
    display: flex;
    flex-direction: column;
  }

  /* A closed group keeps its header only, in the card list and in the table. */
  .task-group[data-open="false"] .task-group-cards,
  .app-table tbody[data-open="false"] tr.is-link {
    display: none;
  }

  /* The app's agent task card, laid out like a notification card: the project
     tile, the title with its tags under it, then the run counts and the status
     select, all level with the card's middle. */
  .task-item {
    width: calc(100% - 16px);
    margin: 0 8px;
    padding: 12px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 10px;
    flex: none;
    border-radius: 12px;
    transition: background 0.18s ease;
  }

  .task-item:hover {
    background: rgba(var(--ink), 0.05);
  }

  /* The project tile is as tall as the controls on the right. */
  .task-tile {
    display: flex;
  }

  .demo-window .task-tile :global(.project-mark) {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    font-size: 11px;
  }

  .task-main {
    min-width: 0;
  }

  .task-item-title {
    display: -webkit-box;
    overflow: hidden;
    color: rgba(var(--ink), 0.92);
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    overflow-wrap: break-word;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  /* The tags: one line of plain muted text, 6px between them. */
  .task-tags {
    margin-top: 2px;
    display: block;
    overflow: hidden;
    color: var(--app-muted);
    font-size: 12px;
    line-height: 16px;
    text-overflow: ellipsis;
    white-space: nowrap;
    word-spacing: 3px;
  }

  .task-side {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .task-side .chip {
    padding: 0 7px;
  }

  .chip.is-runs {
    gap: 6px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .chip.is-select {
    gap: 4px;
    color: rgba(var(--ink), 0.92);
  }

  .demo-window .chip.is-select :global(svg) {
    width: 14px;
    height: 14px;
    margin-right: -4px;
    color: var(--app-muted);
  }

  /* A card the story or a suggestion just put in a group: it comes in from
     above, then a tint fades, as a new task does in the app. */
  .task-item.is-arriving {
    animation: task-item-arrive 1.6s ease-out;
  }

  @keyframes task-item-arrive {
    0% {
      opacity: 0;
      transform: translateY(-6px);
      background-color: rgba(47, 107, 255, 0.16);
    }

    20% {
      opacity: 1;
      transform: none;
    }

    100% {
      background-color: transparent;
    }
  }

  /* The task page: it covers the lists until the visitor goes back. In the
     panel its details sit under the text, on the Tasks page beside it. */
  .task-detail {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--app-bg);
    font-size: 14px;
    line-height: 1.45;
    animation: detail-open 0.25s ease both;
  }

  @keyframes detail-open {
    from {
      opacity: 0;
      transform: translateX(8px);
    }
  }

  .detail-head {
    height: 48px;
    flex: none;
    padding: 0 12px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .screen .detail-head {
    height: 44px;
    padding: 0 12px 0 20px;
  }

  .detail-id {
    flex: none;
    color: #60a5fa;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .detail-title {
    min-width: 0;
    overflow: hidden;
    color: rgba(var(--ink), 0.92);
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .detail-body {
    min-height: 0;
    flex: 1;
    padding: 4px 8px 12px;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(var(--ink), 0.14) transparent;
  }

  .detail-side {
    margin-top: 4px;
    padding-top: 12px;
    border-top: 1px solid var(--app-border);
  }

  .screen .detail-body {
    padding: 12px 20px 20px;
    flex-direction: row;
    overflow: hidden;
  }

  .screen .detail-main {
    min-width: 0;
    flex: 1;
    overflow-y: auto;
  }

  .screen .detail-side {
    width: 320px;
    flex: none;
    margin: 0;
    padding: 0 0 0 12px;
    overflow-y: auto;
    border-top: 0;
    border-left: 1px solid var(--app-border);
  }

  /* The app's collapsible sections: a muted title that turns its arrow. */
  .detail-section :global(summary) {
    height: 32px;
    padding: 0 8px;
    display: flex;
    align-items: center;
    gap: 8px;
    border-radius: 6px;
    color: var(--app-muted);
    cursor: pointer;
    list-style: none;
    transition: color 0.18s ease;
  }

  .detail-section :global(summary::-webkit-details-marker) {
    display: none;
  }

  .detail-section :global(summary:hover) {
    color: rgb(var(--ink));
  }

  .detail-section :global(summary svg) {
    transition: transform 0.15s ease;
  }

  .detail-section[open] > :global(summary svg) {
    transform: rotate(90deg);
  }

  .detail-count {
    margin-left: auto;
    font-variant-numeric: tabular-nums;
  }

  .detail-text {
    padding: 4px 12px 14px;
    color: rgba(var(--ink), 0.88);
    line-height: 1.6;
  }

  .screen .detail-text,
  .worker-instructions {
    color: rgba(var(--ink), 0.9);
    font-size: 18px;
    line-height: 1.75;
  }

  .worker-instructions {
    padding: 4px 24px 0 0;
  }

  .detail-list {
    padding-bottom: 10px;
  }

  /* story.ts writes the runs, so these reach elements without a scope. */
  .detail-list :global(div) {
    min-height: 32px;
    padding: 0 8px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .detail-list :global(dt) {
    min-width: 0;
    overflow: hidden;
    color: var(--app-muted);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .detail-list :global(dd) {
    display: flex;
    flex: none;
    align-items: center;
    gap: 6px;
    color: rgba(var(--ink), 0.92);
  }

  .detail-list :global(.is-strong) {
    color: rgba(var(--ink), 0.92);
  }

  .detail-list :global(.is-muted),
  .is-muted {
    color: var(--app-muted);
  }

  .demo-window :global(.tag-chip) {
    height: 22px;
    margin-right: 4px;
    padding: 0 7px;
    display: inline-flex;
    align-items: center;
    border-radius: 6px;
    background: rgba(var(--ink), 0.06);
    color: rgba(var(--ink), 0.72);
    font-size: 12px;
  }

  .demo-window[data-view="done"] .when-running,
  .demo-window:not([data-view="done"]) .when-done {
    display: none;
  }

  .filled {
    fill: currentColor;
    stroke: none;
  }

  /* ── The hint under the window. It rides the same lift: down with the
     window's start offset, up by what the scale takes off its height. ── */
  .demo-hint {
    --scale: calc(var(--start-scale) + (1 - var(--start-scale)) * var(--lift));
    position: absolute;
    top: calc(var(--window-top) + var(--window-height) + 6px);
    left: 0;
    right: 0;
    padding: 0 16px;
    color: rgba(255, 255, 255, 0.62);
    font-size: 13px;
    line-height: 20px;
    text-align: center;
    transform: translateY(
      calc(var(--start-y) * (1 - var(--lift)) - var(--window-height) * (1 - var(--scale)))
    );
    will-change: transform;
  }

  .hint-story {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .hint-story :global(svg) {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hint-tap,
  .hint-explore,
  .story.is-exploring .hint-story {
    display: none;
  }

  .story.is-exploring .hint-explore {
    display: inline;
  }

  @media (hover: none) {
    .hint-click {
      display: none;
    }

    .hint-tap {
      display: inline;
    }
  }

  .hint-explore button {
    margin-left: 4px;
    color: rgba(255, 255, 255, 0.86);
    font-size: inherit;
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.35);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s ease, color 0.2s ease;
  }

  .hint-explore button:hover {
    color: #fff;
    text-decoration-color: #fff;
  }

  /* ── Other surfaces: short stand-ins ──────────────────────── */
  .surface-browser {
    display: flex;
    flex-direction: column;
  }

  .browser-bar {
    height: 36px;
    flex: none;
    padding: 0 10px;
    display: flex;
    align-items: center;
    gap: 10px;
    border-bottom: 1px solid var(--app-border);
    color: var(--app-muted);
  }

  .browser-url {
    height: 24px;
    flex: 1;
    padding: 0 10px;
    display: flex;
    align-items: center;
    border-radius: 999px;
    background: rgba(var(--ink), 0.06);
    color: rgba(var(--ink), 0.8);
    font-size: 12px;
  }

  .browser-page {
    flex: 1;
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: var(--app-muted);
    text-align: center;
  }

  .browser-page img {
    border-radius: 9px;
  }

  .browser-page strong {
    color: rgba(var(--ink), 0.92);
    font-size: 16px;
    font-weight: 500;
  }

  .term,
  .diff {
    margin: 0;
    padding: 12px 14px;
    color: rgba(var(--ink), 0.86);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.7;
    white-space: pre-wrap;
  }

  .term span,
  .diff span {
    color: var(--app-muted);
  }

  .term b,
  .diff b,
  .diff-file b {
    color: #86efac;
    font-weight: 400;
  }

  .diff i,
  .diff-file i {
    color: #fca5a5;
    font-style: normal;
  }

  .term i {
    width: 7px;
    height: 14px;
    display: inline-block;
    background: rgba(var(--ink), 0.7);
    vertical-align: -2px;
    animation: blink 1.1s steps(1) infinite;
  }

  .file-tree {
    padding: 8px;
    list-style: none;
  }

  .file-tree li {
    height: 28px;
    padding: 0 8px;
    display: flex;
    align-items: center;
    gap: 8px;
    color: rgba(var(--ink), 0.86);
  }

  .file-tree li.is-in { padding-left: 26px; }
  .file-tree li.is-in-2 { padding-left: 44px; }

  .file-tree :global(svg) {
    color: var(--app-muted);
  }

  .diff-file {
    height: 36px;
    padding: 0 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    border-bottom: 1px solid var(--app-border);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .diff-file span {
    min-width: 0;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .surface-chat {
    padding: 16px 14px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 14px;
    line-height: 1.55;
  }

  /* ── Screenshots in the last chat ─────────────────────────── */
  .shots {
    display: grid;
    gap: 14px;
  }

  .shots.is-pair {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .shot {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .shots:not(.is-pair) .shot {
    max-width: 560px;
  }

  /* Side by side, the captions go under the images so the images line up. */
  .is-pair figcaption {
    order: 2;
    color: rgba(var(--ink), 0.72);
    font-size: 13px;
    line-height: 1.5;
  }

  .shot-frame {
    display: block;
    overflow: hidden;
    border: 1px solid var(--app-border);
    border-radius: 10px;
    background: rgba(var(--ink), 0.03);
    transition: border-color 0.18s ease;
  }

  .shot-frame:hover {
    border-color: rgba(var(--ink), 0.2);
  }

  .demo-window .shot-frame:focus-visible {
    border-radius: 10px;
  }

  /* width and height on the img reserve the 3:2 box before it loads. */
  .shot img {
    width: 100%;
    height: auto;
  }

  /* Full-size screenshot: any click or Escape closes it. */
  .shot-viewer {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 56px 16px 16px;
    border: 0;
    background: transparent;
    cursor: zoom-out;
  }

  .shot-viewer[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .shot-viewer::backdrop {
    background: rgba(0, 0, 0, 0.82);
  }

  .shot-viewer img {
    max-width: min(100%, 1600px);
    max-height: 100%;
    object-fit: contain;
    border-radius: 10px;
  }

  .shot-viewer-close {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    cursor: pointer;
  }

  .shot-viewer-close:hover {
    background: rgba(255, 255, 255, 0.22);
  }

  /* ── Full pages: Tasks, Workers, a worker, New bot ────────── */
  .demo-screens {
    position: absolute;
    inset: 0 0 0 240px;
    z-index: 3;
    display: flex;
    background: var(--app-bg);
    font-size: 14px;
    line-height: 1.45;
  }

  .screen {
    position: relative;
    min-width: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .screen-head {
    height: 44px;
    flex: none;
    padding: 0 12px 0 20px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .screen-title {
    min-width: 0;
    overflow: hidden;
    color: rgba(var(--ink), 0.92);
    font-size: 14px;
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .screen-head-end {
    margin-left: auto;
    display: flex;
    flex: none;
    align-items: center;
    gap: 6px;
  }

  .screen-body {
    min-height: 0;
    flex: 1;
    padding: 0 20px 20px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(var(--ink), 0.14) transparent;
  }

  /* The page header's 28px controls. */
  .chip-btn.is-lg {
    height: 28px;
    min-width: 28px;
    border-radius: 8px;
  }

  .chip-btn.is-lg.is-text {
    padding: 0 10px;
    font-size: 13px;
  }

  .chip-btn.is-ghost {
    border-color: transparent;
  }

  button.chip-btn {
    transition: border-color 0.18s ease, color 0.18s ease, background 0.18s ease;
  }

  button.chip-btn:hover {
    border-color: rgba(var(--ink), 0.2);
    color: rgb(var(--ink));
  }

  button.chip-btn.is-ghost:hover {
    border-color: transparent;
    background: rgba(var(--ink), 0.07);
  }

  .select-chip {
    height: 28px;
    padding: 0 8px 0 10px;
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 6px;
    border: 1px solid rgba(var(--ink), 0.1);
    border-radius: 8px;
    color: rgba(var(--ink), 0.88);
    font-size: 13px;
    white-space: nowrap;
  }

  .demo-window .select-chip :global(svg) {
    width: 14px;
    height: 14px;
    color: var(--app-muted);
  }

  .head-action {
    height: 28px;
    padding: 0 12px;
    border: 1px solid rgba(var(--ink), 0.14);
    border-radius: 8px;
    background: rgba(var(--ink), 0.04);
    color: rgba(var(--ink), 0.94);
    font-size: 13px;
    font-weight: 500;
    transition: background 0.18s ease, border-color 0.18s ease;
  }

  .head-action:hover {
    border-color: rgba(var(--ink), 0.26);
    background: rgba(var(--ink), 0.09);
  }

  .hide-wide {
    display: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Tasks: the Me side is the list beside the week, the Workers side a table
     (cards in a narrow window). */
  .screen-side {
    min-height: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .screen-side.is-me {
    flex-direction: row;
  }

  .demo-window:not([data-side="me"]) .screen-side[data-side-view="me"],
  .demo-window[data-side="me"] .screen-side[data-side-view="workers"] {
    display: none;
  }

  .me-list {
    width: 42%;
    min-width: 300px;
    flex: none;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-right: 1px solid var(--app-border);
  }

  .me-week {
    min-width: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .me-list .screen-head,
  .me-week .screen-head {
    padding-right: 10px;
    border-bottom: 1px solid var(--app-border);
  }

  .me-week .screen-head {
    padding-left: 16px;
  }

  .me-list .panel-list {
    min-height: 0;
    flex: 1;
    overflow-y: auto;
    scrollbar-width: none;
  }

  .planner-days.is-week {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 0;
    border-bottom: 0;
  }

  .planner-day-name small.is-today {
    padding: 0 7px;
    border-radius: 999px;
    background: #2f6bff;
    color: #fff;
  }

  /* The app's page tables: hairline rows, a clickable title. */
  .table-scroll {
    overflow-x: auto;
    scrollbar-width: none;
  }

  .app-table {
    width: 100%;
    min-width: 620px;
    border-collapse: collapse;
    text-align: left;
  }

  .app-table th {
    padding: 12px 16px;
    border-bottom: 1px solid var(--app-border);
    color: var(--app-muted);
    font-weight: 500;
    white-space: nowrap;
  }

  .app-table td {
    padding: 15px 16px;
    border-bottom: 1px solid var(--app-border);
    color: rgba(var(--ink), 0.9);
    vertical-align: middle;
  }

  .app-table :is(th, td):first-child {
    padding-left: 0;
  }

  .app-table tr.is-link {
    cursor: pointer;
    transition: background 0.18s ease;
  }

  .app-table tr.is-link:hover {
    background: rgba(var(--ink), 0.03);
  }

  .app-table .col-grip {
    width: 34px;
    padding-right: 0;
    color: var(--app-muted);
  }

  .app-table .col-icon {
    width: 34px;
    padding-right: 0;
  }

  .app-table .col-title {
    max-width: 0;
    overflow: hidden;
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* The grouped Tasks table. Its group headers stick to the page's scroller,
     so the table has no scroller of its own; without a Status column it
     needs less room. */
  .table-scroll.is-grouped {
    overflow: visible;
  }

  .is-grouped .app-table {
    min-width: 480px;
  }

  /* A group's header across the columns: 8px above, 4px below, no rule. Its
     title starts 6px in and its count ends at the table's edge. */
  .app-table .group-row td {
    position: sticky;
    top: 0;
    z-index: 1;
    padding: 8px 0 4px;
    border-bottom: 0;
    background: var(--app-bg);
    transition: background-color 0.4s ease;
  }

  .group-row .task-group-head {
    position: static;
    margin-left: -2px;
    padding: 0;
    background: none;
  }

  /* A row the story or a suggestion just put in a group: a tint fades. */
  .app-table tr.is-arriving {
    animation: task-row-arrive 1.6s ease-out;
  }

  @keyframes task-row-arrive {
    from {
      background-color: rgba(47, 107, 255, 0.16);
    }

    to {
      background-color: transparent;
    }
  }

  /* On the Tasks page the cards run edge to edge and scroll with the page.
     They take the table's place in a narrow window. */
  .screen .task-groups {
    display: none;
    margin: 0 -14px;
    overflow: visible;
  }

  .app-table .col-tags {
    width: 150px;
    white-space: nowrap;
  }

  .app-table .col-runs {
    width: 1%;
    padding-right: 0;
    text-align: right;
    white-space: nowrap;
  }

  .col-runs span + span {
    margin-left: 8px;
  }

  .workers-table .col-name { width: 22%; }
  .workers-table .col-model { width: 25%; }

  .app-table .col-switch {
    width: 88px;
    padding-right: 0;
    text-align: center;
  }

  .link-btn {
    max-width: 100%;
    display: block;
    overflow: hidden;
    color: rgba(var(--ink), 0.94);
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .link-btn:hover {
    text-decoration: underline;
  }

  .switch-btn {
    padding: 4px;
    display: inline-flex;
    border-radius: 999px;
    vertical-align: middle;
  }

  .demo-window .switch-btn:focus-visible {
    border-radius: 999px;
  }

  /* ── The settings look, shared by New bot and Settings ────── */
  .settings-col {
    width: min(100%, 720px);
    margin: 0 auto;
    padding: 8px 0 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .settings-heading {
    margin: 8px 0 -8px 4px;
    color: rgba(var(--ink), 0.95);
    font-size: 16px;
    font-weight: 600;
  }

  .settings-card {
    overflow: hidden;
    border: 1px solid var(--app-border);
    border-radius: 14px;
    background: rgba(var(--ink), 0.02);
  }

  .settings-row {
    min-height: 52px;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .settings-card > * + * {
    border-top: 1px solid var(--app-border);
  }

  .settings-row.is-stacked {
    flex-direction: column;
    align-items: stretch;
    gap: 4px;
  }

  .row-title {
    color: rgba(var(--ink), 0.92);
    font-weight: 500;
  }

  .row-desc {
    color: var(--app-muted);
    font-size: 13px;
  }

  .row-text {
    color: rgba(var(--ink), 0.88);
  }

  .row-control {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 8px;
    color: rgba(var(--ink), 0.92);
    white-space: nowrap;
  }

  .row-control span {
    margin-left: 6px;
    color: var(--app-muted);
  }

  /* New bot: the character, its name, then what it is made of. */
  .bot-defs {
    position: absolute;
  }

  .bot-preview {
    padding: 24px 16px 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  /* The character art keeps its own paint; the window's icon rules stay out. */
  .demo-window :global(svg.bot-char),
  .demo-window .bot-figure,
  .demo-window .tile :is(.shape, .accessory) {
    fill: #000;
    stroke: none;
    stroke-width: 1;
    stroke-linecap: butt;
    stroke-linejoin: miter;
  }

  .demo-window .bot-figure {
    width: 120px;
    height: 120px;
  }

  .demo-window :global(.bot-headwear) {
    paint-order: stroke;
    stroke: #dfebfa38;
    stroke-width: 0.8px;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .bot-name {
    width: min(100%, 384px);
    padding: 2px 6px;
    border: 0;
    border-radius: 6px;
    background: none;
    color: rgba(var(--ink), 0.95);
    font: inherit;
    font-size: 18px;
    font-weight: 600;
    text-align: center;
  }

  .tiles {
    padding: 4px 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .tile {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border: 1px solid transparent;
    border-radius: 8px;
    color: var(--app-muted);
    transition: background 0.18s ease, border-color 0.18s ease;
  }

  .tile:hover {
    background: rgba(var(--ink), 0.06);
  }

  .tile[aria-pressed="true"] {
    border-color: rgba(var(--ink), 0.14);
    background: rgba(var(--ink), 0.07);
  }

  .demo-window .tile .shape {
    width: 32px;
    height: 32px;
  }

  /* An accessory has no body behind it, so a faint outline keeps dark art visible. */
  .demo-window .tile .accessory {
    width: 36px;
    height: 36px;
    filter: drop-shadow(0 0 0.6px #ffffff8c) drop-shadow(0 0 0.6px #ffffff8c);
  }

  .demo-window .tile > :global(svg:not([class])) {
    width: 24px;
    height: 24px;
  }

  .tiles.is-round {
    gap: 6px;
  }

  .tiles.is-round .tile {
    width: 32px;
    height: 32px;
    border-radius: 50%;
  }

  .tiles.is-round .tile i {
    width: 24px;
    height: 24px;
    border-radius: 50%;
  }

  .tiles.is-round .tile[aria-pressed="true"] {
    border-color: rgba(var(--ink), 0.64);
    background: none;
  }

  .demo-window .tiles.is-round .tile:focus-visible {
    border-radius: 50%;
  }

  /* ── Windows over the app: Settings and Usage ─────────────── */
  .demo-modals {
    position: absolute;
    inset: 0;
    z-index: 8;
    padding: 34px 56px;
    display: flex;
    font-size: 14px;
    line-height: 1.45;
  }

  .modal-scrim {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    cursor: default;
  }

  .modal {
    position: relative;
    min-width: 0;
    flex: 1;
    display: flex;
    overflow: hidden;
    border: 1px solid rgba(var(--ink), 0.1);
    border-radius: 14px;
    background: var(--app-bg);
    box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.8);
    animation: modal-open 0.2s ease both;
  }

  @keyframes modal-open {
    from {
      opacity: 0;
      transform: scale(0.985);
    }
  }

  .settings-nav {
    width: 232px;
    flex: none;
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    overflow-y: auto;
    scrollbar-width: none;
    border-right: 1px solid var(--app-border);
    background: rgba(var(--ink), 0.02);
  }

  .settings-search {
    height: 32px;
    flex: none;
    padding: 0 8px;
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--app-muted);
    font-weight: 500;
  }

  .settings-search span {
    flex: 1;
  }

  .settings-group {
    display: flex;
    flex: none;
    flex-direction: column;
    gap: 2px;
  }

  .settings-group h3 {
    padding: 0 8px 2px;
    color: var(--app-muted);
    font-size: 12px;
    font-weight: 500;
  }

  .settings-item {
    height: 30px;
    padding: 0 8px;
    display: flex;
    align-items: center;
    gap: 9px;
    border-radius: 8px;
    color: rgba(var(--ink), 0.72);
    white-space: nowrap;
  }

  .settings-item :global(svg) {
    color: var(--app-muted);
  }

  .settings-item.is-active {
    background: rgba(var(--ink), 0.07);
    color: rgb(var(--ink));
  }

  .modal-main {
    min-width: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .modal-head {
    height: 48px;
    flex: none;
    padding: 0 8px 0 20px;
    display: flex;
