const botSvg = (bot: StoryBot, place: "side" | "pane" | "card") => {
  const shape = botShapes.find((item) => item.id === bot.shape)!;
  const color = botColors.find((item) => item.id === bot.color)!;
  const id = `story-bot-${bot.id}-${place}`;
  return `<svg class="bot-char" viewBox="0 ${shape.centerY - 64} 128 128" aria-hidden="true"><defs><linearGradient id="${id}" x1="0" y1="0" x2=".85" y2="1"><stop stop-color="${color.fill}"/><stop offset="1" stop-color="${color.shade}"/></linearGradient></defs><path d="${shape.path}" fill="url(#${id})"/><rect x="49" y="61" width="11" height="24" rx="5" fill="#fff"/><rect x="70" y="61" width="11" height="24" rx="5" fill="#fff"/></svg>`;
};

