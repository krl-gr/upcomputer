            </div>
            <div class="msg msg-user"><p>Yes.</p></div>
            <!-- data-runs-*: the thread's task run counts once this message shows.
                 data-panel: what the Tasks panel shows from this message on. -->
            <div class="msg msg-agent" data-runs-working="1" data-panel="one">
              <!-- One task, its runs below: the developer first, then the review. -->
              <div class="card task-card">
                <div class="task-title"><span class="task-kind">Task</span>Compact sidebar</div>
                <div class="task-row"><span>UI developer · Claude Opus 5.5</span><em class="is-working">In progress</em></div>
