                  <section class="task-group" data-task-group={group.status} data-open={String(group.open)} aria-label={group.status} hidden={group.count === 0}>
                    <div class="task-group-head">
                      <button type="button" class="task-group-toggle" data-group-toggle aria-expanded={group.open ? "true" : "false"}>
                        <span>{group.status}</span><Fragment set:html={svg("chevronRight")} />
                      </button>
                      <span class="task-group-count" data-group-count>{group.count}</span>
                    </div>
                    <div class="task-group-cards" data-group-cards>
                      {group.tasks.map((task) => {
                        const story = storyStates[task.id];
                        return (
                          <button type="button" class="task-item" {...groupedAttrs(task)}>
                            <span class="task-tile"><b class={`project-mark ${task.project.tone}`} title={task.project.name} data-project-chip data-project-name={task.project.name}>{task.project.mark}</b></span>
                            <span class="task-main">
