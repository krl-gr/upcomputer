                            <td class="col-tags">{task.tags.map((tag) => <span class="tag-chip">{tag}</span>)}</td>
                            <td class="col-runs">
                              {story && story.working > 0 && <span class="run-working when-running">{story.working}</span>}
                              {workingRuns(task) > 0 && <span class:list={["run-working", { "when-done": story }]}>{workingRuns(task)}</span>}
                              {completedRuns(task) > 0 && <span class:list={["run-completed", { "when-done": story }]}>{completedRuns(task)}</span>}
                            </td>
                          </tr>
                        );
                      })}
                    </tbody>
                  ))}
