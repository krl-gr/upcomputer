---
/**
 * The horizon photo that fills its positioned parent, with a starry dot
 * canvas from `horizon.ts` faded in over it. The photo alone remains without
 * JS, with reduced motion, and when WebGL is unavailable. Overlays such as a
 * dim layer or a bottom fade belong to the parent.
 */
---

<div class="horizon" data-horizon aria-hidden="true">
  <picture>
    <source media="(max-width: 899px)" srcset="/hero-horizon-1280.webp" />
    <img src="/hero-horizon.webp" alt="" width="2560" height="1441" fetchpriority="high" />
  </picture>
</div>

<script src="../scripts/horizon.ts"></script>

<style>
  .horizon {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .horizon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Created by horizon.ts, so it carries no scoped attribute. */
  .horizon :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .horizon :global(canvas.is-ready) {
    opacity: 1;
  }
</style>
