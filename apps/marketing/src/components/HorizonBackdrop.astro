---
/**
 * The horizon behind the top of a page. It fills its positioned parent. The
 * <picture> is the whole backdrop without JS, with reduced motion or without
 * WebGL. Otherwise the page starts dark with the photo hidden, and
 * horizon-backdrop.ts plays the scene in on a canvas like an old TV switching
 * on (curved planet, atmosphere, stars, faint noise). If no live frame comes
 * in time, the photo fades in instead (`is-fallback`).
 */
---

<!-- Before first paint, so the photo never flashes before the intro. -->
<script is:inline>
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.documentElement.classList.add("horizon-boot");
  }
</script>

<div class="horizon" data-horizon-backdrop aria-hidden="true">
  <picture>
    <source media="(max-width: 899px)" srcset="/hero-horizon-1280.webp" />
    <img src="/hero-horizon.webp" alt="" width="2560" height="1441" fetchpriority="high" />
  </picture>
  <canvas></canvas>
</div>

<script src="../scripts/horizon-backdrop.ts"></script>

<style>
  .horizon {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .horizon img,
  .horizon canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .horizon img {
    object-fit: cover;
  }

  .horizon canvas {
    display: block;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .horizon canvas.is-live {
    opacity: 1;
  }

  /* Dark start: the canvas intro begins from black, so it needs no fade. */
  :global(html.horizon-boot) .horizon picture {
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  :global(html.horizon-boot) .horizon canvas {
    transition: none;
  }

  :global(html.horizon-boot) .horizon.is-fallback picture {
    opacity: 1;
  }

  :global(html.horizon-boot) .horizon.is-fallback canvas {
    transition: opacity 1.2s ease;
  }
</style>
