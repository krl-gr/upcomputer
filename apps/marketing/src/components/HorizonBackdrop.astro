---
/**
 * The horizon photo behind the top of a page. It fills its positioned
 * parent. The <picture> is the base layer and the whole backdrop without JS,
 * with reduced motion or without WebGL; horizon-backdrop.ts fades a canvas in
 * over it that drifts toward the horizon with faint old-TV noise.
 */
---

<div class="horizon" data-horizon-backdrop aria-hidden="true">
  <picture>
    <source media="(max-width: 899px)" srcset="/hero-horizon-1280.webp" />
    <img src="/hero-horizon.webp" alt="" width="2560" height="1441" fetchpriority="high" />
  </picture>
  <canvas></canvas>
</div>

<script src="../scripts/horizon-backdrop.ts"></script>

<style>
  .horizon {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .horizon img,
  .horizon canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .horizon img {
    object-fit: cover;
  }

  .horizon canvas {
    display: block;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .horizon canvas.is-live {
    opacity: 1;
  }
</style>
