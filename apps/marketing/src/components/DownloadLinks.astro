---
/**
 * "Download for macOS, Windows, Linux": one line in the type of .story-title
 * in ChatStory.astro, where only the OS names are links to the release assets.
 */
import { RELEASE_TAG, releaseAssetUrl } from "../lib/releases";

interface Props {
  /** `data-analytics-placement` of the links. */
  placement: string;
}

const { placement } = Astro.props;

const platforms = [
  { name: "macOS", platform: "macos", architecture: "arm64", format: "dmg", asset: "arm64.dmg" },
  { name: "Windows", platform: "windows", architecture: "x64", format: "exe", asset: "x64.exe" },
  {
    name: "Linux",
    platform: "linux",
    architecture: "x86_64",
    format: "appimage",
    asset: "x86_64.AppImage",
  },
];
---

<p class="download-links">
  Download for{" "}
  {platforms.map((item, index) => (
    <>
      <a
        href={releaseAssetUrl(item.asset)}
        data-analytics-event="marketing_download_clicked"
        data-analytics-platform={item.platform}
        data-analytics-architecture={item.architecture}
        data-analytics-format={item.format}
        data-analytics-release={RELEASE_TAG}
        data-analytics-placement={placement}>{item.name}</a>{index < platforms.length - 1 && ", "}
    </>
  ))}
</p>

<style>
  .download-links {
    color: #fff;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: -0.005em;
    text-align: center;
  }

  .download-links a {
    /* Taller hit area for touch; inline padding does not move the line. */
    padding: 10px 2px;
    margin: 0 -2px;
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.35);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: text-decoration-color 0.2s ease;
  }

  .download-links a:hover,
  .download-links a:focus-visible {
    text-decoration-color: #fff;
  }
</style>
