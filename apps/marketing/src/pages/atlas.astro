---
import rawData from "../data/atlas.json";
import Layout from "../layouts/Layout.astro";
import {
  DEFAULT_OPEN,
  DEFAULT_PRODUCTS,
  cellKey,
  flattenTree,
  surfaceTag,
  type AtlasData,
} from "../lib/atlas";

const data = rawData as AtlasData;
const flat = flattenTree(data.nodes);
const cells = new Map(data.cells.map((c) => [cellKey(c.capability_id, c.product_id), c]));
const initialOpen = new Set(DEFAULT_OPEN);
const initialProducts = new Set(DEFAULT_PRODUCTS);
const featureCount = flat.filter((n) => n.kind === "capability").length;
const groupCounts = new Map(
  flat
    .filter((n) => n.kind === "group")
    .map((n) => [n.id, flat.filter((c) => c.kind === "capability" && c.ancestors.includes(n.id)).length]),
);
---

<Layout
  title="CLI Atlas — what your coding agent can do"
  description="Compare what Claude Code, Codex, Cursor CLI, OpenCode, Pi and Hermes Agent can do, with the exact command or shortcut for each feature and a link to the official docs."
>
  <section class="atlas">
    <header class="atlas-head">
      <p class="atlas-eyebrow">CLI Atlas</p>
      <h1>What your coding agent can do</h1>
      <p>
        Features on the left, the exact command or shortcut in each tool on the right. Open a cell for
        the official page behind it.
      </p>
    </header>

    <div class="atlas-toolbar">
      <label class="atlas-search">
        <span class="sr-only">Search</span>
        <input
          id="tree-query"
          type="search"
          placeholder="Search features, commands or shortcuts: fork, /compact, Ctrl+G"
          autocomplete="off"
        />
      </label>
      <label class="atlas-select">
        <span class="sr-only">Show</span>
        <select id="tree-view">
          <option value="all">All features</option>
          <option value="differs">Where tools differ</option>
          <option value="mapped">In any selected tool</option>
          <option value="gaps">Missing in a selected tool</option>
        </select>
      </label>
      <details class="product-picker">
        <summary>Tools <span id="selected-count">{DEFAULT_PRODUCTS.length}</span></summary>
        <div class="product-popover">
          {data.products.map((p) => (
            <label class="product-option">
              <input type="checkbox" name="compare-product" value={p.id} checked={initialProducts.has(p.id)} />
              <span>{p.name}<small>{p.feature_count} documented features</small></span>
            </label>
          ))}
          <div class="product-presets">
            <button type="button" id="select-inventories">All tools</button>
            <button type="button" id="reset-products">Reset</button>
          </div>
        </div>
      </details>
    </div>

    <div class="tree-actions">
      <div>
        <button type="button" id="expand-tree">Expand all</button>
        <button type="button" id="collapse-tree">Collapse all</button>
        <button type="button" id="reset-search" hidden>Reset search</button>
      </div>
      <span id="tree-result" role="status" aria-live="polite">{featureCount} features · first section open</span>
    </div>

    <p class="matrix-key">
      <span><code>Ctrl+G</code> how to use it</span>
      <span><b class="mark">?</b> something close, not confirmed</span>
      <span><b class="mark">—</b> not in the docs</span>
    </p>

    <noscript>
      <p class="atlas-noscript">Without JavaScript, the first section and four tools are shown.</p>
    </noscript>

    <div class="tree-scroll" role="region" aria-label="Feature comparison" tabindex="0">
      <table class="capability-tree">
        <caption class="sr-only">
          Feature comparison. Section buttons expand nested rows; cell buttons open details and sources.
        </caption>
        <thead>
          <tr>
            <th scope="col" class="tree-first">Feature</th>
            {data.products.map((p) => (
              <th scope="col" data-product-column={p.id} hidden={!initialProducts.has(p.id)}>{p.name}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {flat.map((n) => (
            <tr
              id={`cap-${n.id}`}
              data-node={n.id}
              data-kind={n.kind}
              hidden={!n.ancestors.every((id) => initialOpen.has(id))}
            >
              <th scope="row" class="tree-first" style={`--depth:${n.depth}`}>
                {n.kind === "group" ? (
                  <button class="tree-toggle" type="button" data-toggle={n.id} aria-expanded={initialOpen.has(n.id) ? "true" : "false"}>
                    <span class="chevron" aria-hidden="true">›</span>
                    <span>{n.label}</span>
                    <small>{groupCounts.get(n.id)}</small>
                  </button>
                ) : (
                  <div class="tree-leaf">
                    <span class="leaf-text">
                      <span>{n.label}</span>
                      {n.summary && <small>{n.summary}</small>}
                    </span>
                    <a class="row-link" href={`#cap-${n.id}`} aria-label={`Link to ${n.label}`}>#</a>
                  </div>
                )}
              </th>
              {n.kind === "group" ? (
                <td class="group-fill" colspan={DEFAULT_PRODUCTS.length}></td>
              ) : (
                data.products.map((p) => {
                  const c = cells.get(cellKey(n.id, p.id));
                  const tag = c && surfaceTag(c);
                  const outdated = c && (c.freshness === "stale" || c.freshness === "superseded");
                  return (
                    <td data-product-column={p.id} hidden={!initialProducts.has(p.id)}>
                      {c ? (
                        <button
                          type="button"
                          class:list={["cell", { "is-missing": c.status !== "documented" }]}
                          data-cell={cellKey(n.id, p.id)}
                          aria-haspopup="dialog"
                          aria-label={`${p.name}: ${n.label}. ${
                            c.status === "unresolved"
                              ? "Not confirmed in the docs"
                              : c.status === "not_found"
                                ? "Not in the docs"
                                : c.names.join(", ")
                          }. Details`}
                        >
                          {c.status === "unresolved" ? (
                            <b class="mark" title="Something close is documented, but not this exact behavior">?</b>
                          ) : c.status === "not_found" ? (
                            <b class="mark">—</b>
                          ) : (
                            <span class="cell-names">
                              {c.names.map((name) => <code>{name}</code>)}
                            </span>
                          )}
                          {(tag || outdated) && (
                            <span class="cell-meta">
                              {tag && <span>{tag}</span>}
                              {outdated && <span class="is-warn">may be outdated</span>}
                            </span>
                          )}
                        </button>
                      ) : (
                        <span class="not-checked" title="Not checked yet"><span class="sr-only">Not checked yet</span></span>
                      )}
                    </td>
                  );
                })
              )}
            </tr>
          ))}
        </tbody>
      </table>
      <div id="tree-empty" class="tree-empty" hidden>
        <strong>No matching features</strong>
        <p>Try another term or add more tools.</p>
        <button type="button" id="empty-reset">Reset search</button>
      </div>
    </div>

    <footer class="atlas-foot">
      <p>
        Built from each tool’s official documentation, not hands-on tests. Every answer links to the page it
        comes from; “?” means the docs describe something close but not this exact behavior. Spotted a
        mistake? <a href="https://github.com/krl-gr/upcomputer/issues" target="_blank" rel="noopener noreferrer">Tell us</a>.
      </p>
      <span>Updated {data.built_at}</span>
    </footer>
  </section>

  <dialog id="cell-dialog" class="cell-dialog" aria-labelledby="cell-title" aria-describedby="cell-path">
    <div class="dialog-top">
      <span id="cell-product"></span>
      <form method="dialog"><button class="dialog-close" aria-label="Close" autofocus>×</button></form>
    </div>
    <p id="cell-path"></p>
    <h2 id="cell-title"></h2>
    <div id="cell-content"></div>
  </dialog>

  <script is:inline type="application/json" id="atlas-data" set:html={JSON.stringify(data).replace(/</g, "\\u003c")} />
  <script src="../scripts/atlas.ts"></script>
</Layout>

<style>
  .atlas {
    /* Same content box as the nav: 1240px container with 32px padding. */
    width: min(1176px, calc(100% - 64px));
    margin: 0 auto;
    padding: 132px 0 72px;
  }

  .atlas-head {
    max-width: 640px;
    margin-bottom: 36px;
  }

  .atlas-eyebrow {
    margin-bottom: 14px;
    color: var(--fg-dim);
    font-size: 13px;
  }

  .atlas-head h1 {
    margin-bottom: 12px;
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .atlas-head p:last-child {
    color: var(--fg-muted);
    font-size: 15px;
  }

  /* ── Controls ─────────────────────────────────────────────── */
  .atlas-toolbar {
    display: flex;
    gap: 8px;
    align-items: stretch;
  }

  .atlas-search {
    flex: 1;
    min-width: 0;
  }

  .atlas-search input,
  .atlas-select select,
  .product-picker summary {
    width: 100%;
    height: 40px;
    padding: 0 14px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.025);
    color: var(--fg);
    font: inherit;
    font-size: 14px;
    outline: none;
    transition: border-color 0.18s ease;
  }

  .atlas-search input::placeholder {
    color: var(--fg-faint);
  }

  .atlas-search input:focus,
  .atlas-select select:focus {
    border-color: var(--border-strong);
  }

  .atlas-select select {
    width: 220px;
    appearance: none;
    cursor: pointer;
  }

  .product-picker {
    position: relative;
  }

  .product-picker summary {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    list-style: none;
    white-space: nowrap;
  }

  .product-picker summary::-webkit-details-marker {
    display: none;
  }

  .product-picker summary span {
    color: var(--fg-dim);
  }

  .product-popover {
    position: absolute;
    z-index: 20;
    top: calc(100% + 6px);
    right: 0;
    width: 280px;
    padding: 6px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: #141416;
    box-shadow: 0 24px 48px -16px rgba(0, 0, 0, 0.7);
  }

  .product-option {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 14px;
  }

  .product-option:hover {
    background: rgba(255, 255, 255, 0.04);
  }

  .product-option input {
    margin-top: 4px;
    accent-color: #fafafa;
  }

  .product-option small {
    display: block;
    color: var(--fg-dim);
    font-size: 12px;
  }

  .product-presets {
    display: flex;
    gap: 4px;
    margin-top: 4px;
    padding-top: 6px;
    border-top: 1px solid var(--border);
  }

  .product-presets button,
  .tree-actions button,
  .tree-empty button {
    padding: 6px 10px;
    border-radius: 8px;
    color: var(--fg-muted);
    font-size: 13px;
    transition: color 0.18s ease, background 0.18s ease;
  }

  .product-presets button:hover,
  .tree-actions button:hover,
  .tree-empty button:hover {
    background: rgba(255, 255, 255, 0.05);
    color: var(--fg);
  }

  .tree-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin: 14px 0 6px;
    color: var(--fg-dim);
    font-size: 13px;
  }

  .tree-actions > div {
    display: flex;
    gap: 2px;
    margin-left: -10px;
  }

  .matrix-key {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 14px;
    color: var(--fg-dim);
    font-size: 13px;
  }

  .matrix-key span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .atlas-noscript {
    margin-bottom: 14px;
    color: var(--fg-muted);
    font-size: 13px;
  }

  /* ── Table ────────────────────────────────────────────────── */
  .tree-scroll {
    position: relative;
    max-height: calc(100vh - 120px);
    overflow: auto;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: #0e0e10;
    outline: none;
  }

  .capability-tree {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 14px;
  }

  .capability-tree th,
  .capability-tree td {
    padding: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    text-align: left;
    vertical-align: top;
  }

  .capability-tree thead th {
    position: sticky;
    top: 0;
    z-index: 3;
    height: 44px;
    padding: 0 14px;
    background: #0e0e10;
    color: var(--fg-muted);
    font-size: 13px;
    font-weight: 500;
    vertical-align: middle;
    white-space: nowrap;
  }

  .capability-tree .tree-first {
    position: sticky;
    left: 0;
    z-index: 2;
    width: 340px;
    min-width: 280px;
    background: #0e0e10;
    border-right: 1px solid rgba(255, 255, 255, 0.05);
  }

  .capability-tree thead .tree-first {
    z-index: 4;
  }

  .capability-tree td {
    min-width: 180px;
  }

  .tree-toggle {
    width: 100%;
    min-height: 40px;
    padding: 0 14px 0 calc(14px + var(--depth) * 16px);
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--fg);
    font-size: 14px;
    font-weight: 500;
    text-align: left;
  }

  .tree-toggle small {
    margin-left: auto;
    color: var(--fg-faint);
    font-size: 12px;
    font-weight: 400;
  }

  .chevron {
    width: 12px;
    color: var(--fg-dim);
    transition: transform 0.15s ease;
  }

  .tree-toggle[aria-expanded="true"] .chevron {
    transform: rotate(90deg);
  }

  .tree-toggle:disabled {
    cursor: default;
  }

  tr[data-kind="group"] .group-fill {
    background: rgba(255, 255, 255, 0.012);
  }

  tr[data-kind="group"] .tree-first {
    background: #111113;
  }

  .tree-leaf {
    min-height: 44px;
    padding: 10px 14px 10px calc(34px + (var(--depth) - 1) * 16px);
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .leaf-text {
    min-width: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    color: rgba(255, 255, 255, 0.86);
  }

  .leaf-text small {
    color: var(--fg-dim);
    font-size: 12px;
    line-height: 1.45;
  }

  .row-link {
    color: var(--fg-faint);
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  tr:hover .row-link,
  .row-link:focus-visible {
    opacity: 1;
  }

  .cell {
    width: 100%;
    min-height: 44px;
    padding: 10px 14px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    text-align: left;
    transition: background 0.15s ease;
  }

  .cell:hover {
    background: rgba(255, 255, 255, 0.03);
  }

  .cell-names {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  code {
    padding: 1px 6px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.9);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .mark {
    color: var(--fg-faint);
    font-weight: 500;
  }

  .cell-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    color: var(--fg-dim);
    font-size: 11px;
  }

  .cell-meta .is-warn {
    color: var(--warn);
  }

  .not-checked {
    display: block;
    min-height: 44px;
  }

  .tree-empty {
    padding: 48px 24px;
    text-align: center;
    color: var(--fg-muted);
  }

  .tree-empty strong {
    display: block;
    margin-bottom: 4px;
    color: var(--fg);
    font-weight: 500;
  }

  .tree-empty button {
    margin-top: 12px;
  }

  .atlas-foot {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: 20px;
    color: var(--fg-dim);
    font-size: 13px;
  }

  .atlas-foot p {
    max-width: 720px;
  }

  .atlas-foot a {
    color: var(--fg-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .atlas-foot span {
    flex: none;
  }

  /* ── Details dialog ───────────────────────────────────────── */
  .cell-dialog {
    width: min(520px, calc(100vw - 32px));
    max-height: calc(100vh - 64px);
    margin: auto;
    padding: 20px 22px 24px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: #141416;
    color: var(--fg);
    box-shadow: 0 32px 80px -24px rgba(0, 0, 0, 0.8);
  }

  .cell-dialog::backdrop {
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(2px);
  }

  .dialog-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--fg-dim);
    font-size: 13px;
  }

  .dialog-close {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    color: var(--fg-muted);
    font-size: 20px;
    line-height: 1;
  }

  .dialog-close:hover {
    background: rgba(255, 255, 255, 0.06);
    color: var(--fg);
  }

  #cell-path {
    margin-top: 10px;
    color: var(--fg-dim);
    font-size: 12px;
  }

  #cell-title {
    margin: 2px 0 14px;
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  #cell-content :global(p) {
    margin-bottom: 12px;
    color: var(--fg-muted);
    font-size: 14px;
  }

  #cell-content :global(.cell-how) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 12px;
  }

  #cell-content :global(code) {
    padding: 1px 6px;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.9);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  #cell-content :global(.cell-warning) {
    color: var(--warn);
  }

  #cell-content :global(h3) {
    margin: 18px 0 8px;
    color: var(--fg-dim);
    font-size: 12px;
    font-weight: 500;
  }

  #cell-content :global(ul) {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  #cell-content :global(li a) {
    color: var(--fg);
    font-size: 14px;
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.25);
    text-underline-offset: 3px;
  }

  #cell-content :global(blockquote) {
    margin-top: 6px;
    padding-left: 12px;
    border-left: 2px solid rgba(255, 255, 255, 0.12);
    color: var(--fg-muted);
    font-size: 13px;
  }

  #cell-content :global(.record-dates) {
    margin: 14px 0 0;
    color: var(--fg-dim);
    font-size: 12px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 820px) {
    .atlas {
      width: calc(100% - 24px);
      padding-top: 104px;
    }

    .atlas-toolbar {
      flex-wrap: wrap;
    }

    .atlas-search {
      flex-basis: 100%;
    }

    .atlas-select {
      flex: 1;
    }

    .atlas-select select {
      width: 100%;
    }

    .capability-tree .tree-first {
      width: 200px;
      min-width: 200px;
    }

    .capability-tree td {
      min-width: 150px;
    }

    .atlas-foot {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
