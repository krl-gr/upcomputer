---
import ChatStory from "../components/ChatStory.astro";
import DownloadLinks from "../components/DownloadLinks.astro";
import Layout from "../layouts/Layout.astro";
import { SOFTWARE_APPLICATION_STRUCTURED_DATA } from "../lib/site";
---

<Layout
  title="Up.computer · The self-orchestrating control plane for coding agents"
  description="A self-orchestrating control plane for the agent CLIs you already use. It turns your ideas into tasks and hands them to your agents. Free and open source, any provider, every chat on your computer."
  structuredData={SOFTWARE_APPLICATION_STRUCTURED_DATA}
  backdrop="none"
>
  <ChatStory />

  <div class="closing">
    <DownloadLinks placement="homepage_final_cta" />
  </div>
</Layout>

<style>
  .closing {
    padding: 56px 24px;
  }
</style>
