---
import ChatStory from "../components/ChatStory.astro";
import DownloadLinks from "../components/DownloadLinks.astro";
import Layout from "../layouts/Layout.astro";
import { SOFTWARE_APPLICATION_STRUCTURED_DATA } from "../lib/site";
---

<Layout
  title="Up.computer · Your agents, your data, any provider"
  description="One local home for the agent CLIs you already use. Free and open source. Bring any provider, run tasks in the background, and keep every chat on your computer."
  structuredData={SOFTWARE_APPLICATION_STRUCTURED_DATA}
  backdrop="none"
>
  <ChatStory />

  <div class="closing">
    <DownloadLinks placement="homepage_final_cta" />
  </div>
</Layout>

<style>
  .closing {
    padding: 56px 24px;
  }
</style>
