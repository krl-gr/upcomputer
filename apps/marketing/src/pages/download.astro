---
import DownloadLinks from "../components/DownloadLinks.astro";
import Layout from "../layouts/Layout.astro";
import { RELEASE_TAG, RELEASE_URL, RELEASE_VERSION, releaseAssetUrl } from "../lib/releases";
---

<Layout
  title="Download · Up.computer"
  description="Download Up.computer for macOS, Windows, or Linux. Free and open source."
>
  <div class="download-page">
    <DownloadLinks placement="download_page" />
    <p class="release">
      Version {RELEASE_VERSION} ·{" "}
      <a
        href={releaseAssetUrl("x64.dmg")}
        data-analytics-event="marketing_download_clicked"
        data-analytics-platform="macos"
        data-analytics-architecture="x64"
        data-analytics-format="dmg"
        data-analytics-release={RELEASE_TAG}
        data-analytics-placement="download_page"
      >Intel Mac</a>{" "}·{" "}
      <a
        href={RELEASE_URL}
        target="_blank"
        rel="noopener noreferrer"
        data-analytics-event="marketing_changelog_clicked"
        data-analytics-placement="download_page"
      >View changelog<span aria-hidden="true"> ↗</span></a>
    </p>
  </div>
</Layout>

<style>
  /* Centered between the fixed nav and the footer. */
  .download-page {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 120px 24px 96px;
    animation: fade-in 0.8s ease-out both;
  }

  /* Same type as the download line, muted. */
  .release {
    color: var(--fg-muted);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: -0.005em;
    text-align: center;
  }

  .release a {
    padding: 10px 2px;
    margin: 0 -2px;
    text-decoration: underline;
    text-decoration-color: rgba(161, 161, 170, 0.35);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .release a:hover,
  .release a:focus-visible {
    color: #fff;
    text-decoration-color: #fff;
  }
</style>
