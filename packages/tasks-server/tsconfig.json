{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ESNext", "esnext.disposable"],
    "plugins": [
      {
        "name": "@effect/language-service",
        // Imported as-is from the former private package. These rules report
        // existing code; tighten them once the package is migrated.
        "diagnosticSeverity": {
          "anyUnknownInErrorContext": "suggestion",
          "deterministicKeys": "suggestion",
          "globalConsoleInEffect": "suggestion",
          "globalDate": "suggestion",
          "globalDateInEffect": "suggestion",
          "globalErrorInEffectFailure": "suggestion",
          "instanceOfSchema": "suggestion",
          "missingReturnYieldStar": "suggestion",
          "multipleEffectProvide": "suggestion",
          "nodeBuiltinImport": "suggestion",
          "preferSchemaOverJson": "suggestion",
          "unknownInEffectCatch": "suggestion"
        }
      }
    ]
  },
  "include": ["src", "vite.config.ts"]
}
