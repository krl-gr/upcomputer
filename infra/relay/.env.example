# Required: Relay API and managed tunnel domains
# Production adopts retained DNS zones in your Cloudflare account. The API
# zone serves relay.<zone> in production and relay-<stage>.<zone> for personal
# stages. Managed environment endpoints are provisioned below the tunnel zone.
# Up.computer uses up.computer (relay.up.computer) and upconnect.dev.
RELAY_API_ZONE_NAME=up.computer
RELAY_TUNNEL_ZONE_NAME=upconnect.dev

# Optional: inactive tunnel cleanup. Start with dry-run, verify the cleanup
# logs, then set enabled. Unset and off both disable cleanup.
# RELAY_TUNNEL_CLEANUP_MODE=off
# Optional: cleanup for tunnels whose host never registered recovery, once they
# have been down for 30 days. Same values, independent of the mode above.
# RELAY_LEGACY_TUNNEL_CLEANUP_MODE=off
# Canary stages only: shorten the 30-day legacy grace period, in minutes.
# Ignored on prod.
# RELAY_LEGACY_TUNNEL_GRACE_MINUTES=10

# Optional: relay monitors and health dashboard in Axiom. Set the notifier id
# that pages (incident.io in prod) to create them; unset creates neither, so
# personal stages never page anyone. Warnings go to their own notifier, or
# only show in Axiom when it is unset.
# RELAY_ALERT_NOTIFIER_ID=
# RELAY_WARNING_NOTIFIER_ID=

# Optional: Relay domain override
# Set this only when the derived relay hostname should not be used.
# RELAY_DOMAIN=relay.example.com

# Required: Clerk
# Get the keys from the Clerk Dashboard under API keys. Set the JWT audience to
# the `aud` claim configured on the `t3-relay` JWT template.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWT_AUDIENCE=t3-code-relay

# Optional: Apple Push Notification service
# Off unless APNS_ENABLED=true. While off, the relay needs no Apple credentials
# and sends no iOS pushes or Live Activities. When on, the APNS_* values below
# are required: get them from your Apple Developer account. Use `sandbox` for
# development APNs credentials and `production` for production credentials.
APNS_ENABLED=false
# APNS_ENVIRONMENT=sandbox
# APNS_TEAM_ID=...
# APNS_KEY_ID=...
# APNS_BUNDLE_ID=...
# APNS_PRIVATE_KEY=...

# Optional: Android push. Set this secret to the service account JSON from
# Firebase Project settings > Service accounts. Never put it in an app build.
# FCM_SERVICE_ACCOUNT={...}

# Optional: web push to browsers and the iPhone Home Screen web app
# Off unless WEB_PUSH_ENABLED=true. While off, the relay reads no WEB_PUSH_*
# value and sends no web pushes. Generate the key pair with
# `vp run --filter t3code-relay web-push:vapid-keys`. The public key also goes
# into the web build as T3CODE_WEB_PUSH_VAPID_PUBLIC_KEY; the private key is a
# secret. The subject is a contact for push services: mailto: or https:.
WEB_PUSH_ENABLED=false
# WEB_PUSH_VAPID_PUBLIC_KEY=...
# WEB_PUSH_VAPID_PRIVATE_KEY=...
# WEB_PUSH_SUBJECT=mailto:push@up.computer
